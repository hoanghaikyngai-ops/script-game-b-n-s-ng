local camModeBackup = nil

local function restoreCameraMode()
    if camModeBackup then
        pcall(function()
            LP.CameraMinZoomDistance = 0.5
            LP.CameraMaxZoomDistance = camModeBackup.max
            LP.CameraMinZoomDistance = camModeBackup.min
            LP.CameraMode = camModeBackup.mode
        end)
        camModeBackup = nil
    end
end

bind(RunService.RenderStepped, function()
    if not CFG.ForceThird then
        restoreCameraMode()
        return
    end
    if not camModeBackup then
        camModeBackup = { mode = LP.CameraMode, min = LP.CameraMinZoomDistance, max = LP.CameraMaxZoomDistance }
    end
    pcall(function()
        local d = CFG.ThirdDistance
        LP.CameraMode = Enum.CameraMode.Classic              -- gỡ LockFirstPerson
        LP.CameraMaxZoomDistance = math.max(d, 20)           -- đặt Max trước để Min không bị kẹp
        LP.CameraMinZoomDistance = d                         -- không cho zoom vào góc nhìn thứ nhất
    end)
    -- game đang giữ camera ở Scriptable mà không phải do aim của mình => trả về Custom
    local cam = Workspace.CurrentCamera
    if cam and cam.CameraType == Enum.CameraType.Scriptable and not camTypeBackup then
        pcall(function() cam.CameraType = Enum.CameraType.Custom end)
    end
end)

