local originalMapColors = setmetatable({}, { __mode = "k" })
local originalEffectStates = setmetatable({}, { __mode = "k" })
local originalGlobalShadows = game:GetService("Lighting").GlobalShadows
local originalRender = nil
local mapJobRunning = false

local function isCharacterOrToolPart(part)
    local model = part:FindFirstAncestorOfClass("Model")
    if model and model:FindFirstChildOfClass("Humanoid") then return true end
    local tool = part:FindFirstAncestorOfClass("Tool")
    return tool ~= nil
end

local function setMapWhite(enabled)
    if mapJobRunning then return end
    mapJobRunning = true
    task.spawn(function()
        local count = 0
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not isCharacterOrToolPart(obj) then
                if enabled then
                    if originalMapColors[obj] == nil then originalMapColors[obj] = obj.Color end
                    obj.Color = Color3.new(1, 1, 1)
                elseif originalMapColors[obj] ~= nil then
                    obj.Color = originalMapColors[obj]
                    originalMapColors[obj] = nil
                end
                count += 1
                if count % 250 == 0 then task.wait() end
            end
        end
        mapJobRunning = false
    end)
end

local function isHeavyVisual(obj)
    return obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
        or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles")
        or obj:IsA("PostEffect")
end

local function setFixLag(enabled)
    local Lighting = game:GetService("Lighting")
    if enabled then
        Lighting.GlobalShadows = false
        pcall(function()
            local terrain = Workspace.Terrain
            if originalRender == nil then
                originalRender = {
                    Decoration = terrain.Decoration,
                    WaveSize = terrain.WaterWaveSize,
                    WaveSpeed = terrain.WaterWaveSpeed,
                }
            end
            terrain.Decoration = false
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
        end)
        local count = 0
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if isHeavyVisual(obj) then
                if originalEffectStates[obj] == nil then
                    originalEffectStates[obj] = obj.Enabled
                end
                obj.Enabled = false
                count += 1
                if count % 250 == 0 then task.wait() end
            end
        end
        for _, obj in ipairs(Lighting:GetDescendants()) do
            if isHeavyVisual(obj) then
                if originalEffectStates[obj] == nil then
                    originalEffectStates[obj] = obj.Enabled
                end
                obj.Enabled = false
            end
        end
    else
        Lighting.GlobalShadows = originalGlobalShadows
        if originalRender then
            pcall(function()
                local terrain = Workspace.Terrain
                terrain.Decoration = originalRender.Decoration
                terrain.WaterWaveSize = originalRender.WaveSize
                terrain.WaterWaveSpeed = originalRender.WaveSpeed
            end)
            originalRender = nil
        end
        for obj, wasEnabled in pairs(originalEffectStates) do
            pcall(function() obj.Enabled = wasEnabled end)
            originalEffectStates[obj] = nil
        end
    end
end

task.defer(function()
    if CFG.MapWhite then setMapWhite(true) end
    if CFG.FixLag then setFixLag(true) end
end)

bind(Workspace.DescendantAdded, function(obj)
    if CFG.FixLag and isHeavyVisual(obj) then
        pcall(function()
            if originalEffectStates[obj] == nil then originalEffectStates[obj] = obj.Enabled end
            obj.Enabled = false
        end)
    end
end)

