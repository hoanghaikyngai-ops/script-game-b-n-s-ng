local function refreshLock()
    if not CFG.AimLock then
        State.CamFree = false
        State.PlayerLock = nil -- tắt Aim camera thì mở khóa người luôn
    end
    if State.PlayerLock then
        lockBtn.Text = "🔐 MỞ KHÓA"
        lockBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
    else
        lockBtn.Text = "🔓 KHÓA NGƯỜI"
        lockBtn.BackgroundColor3 = CFG.AimLock and Color3.fromRGB(50, 110, 200) or Color3.fromRGB(70, 70, 80)
    end
    keyBtn.Text = "[" .. CFG.LockKey.Name .. "]"

    if State.CamFree then
        camBtn.Text = "🔒 KHÓA CAM [" .. CFG.FreeCamKey.Name .. "]"
        camBtn.BackgroundColor3 = Color3.fromRGB(200, 130, 30)
    else
        camBtn.Text = "🔓 MỞ CAM [" .. CFG.FreeCamKey.Name .. "]"
        camBtn.BackgroundColor3 = CFG.AimLock and Color3.fromRGB(50, 150, 90) or Color3.fromRGB(70, 70, 80)
    end
end

-- KHÓA NGƯỜI: đang nhắm ai thì khóa cứng người đó; bấm lại = mở khóa, lại lia theo người gần nhất.
local function toggleLock()
    if not CFG.AimLock then return end
    if State.PlayerLock then
        State.PlayerLock = nil
    else
        State.PlayerLock = getTarget() -- người đang bị nhắm (gần nhất) lúc bấm
    end
    refreshLock()
end

local function toggleCam()
    if not CFG.AimLock then return end
    State.CamFree = not State.CamFree
    refreshLock()
end

