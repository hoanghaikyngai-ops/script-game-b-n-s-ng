    ESP = false, AimLock = false, SilentAim = false, Fly = false, HighJump = false,
    InfJump = false, Speed = false, Chase = false, AutoShoot = false, AutoSwitch = false,
    HitboxEnemy = false, HitboxWeapon = false, TeamCheck = false,

    ScanRange   = 10000, -- tầm quét người chơi để đuổi theo (stud)
    ChaseSpeed  = 400,   -- tốc độ bay lên đầu kẻ địch (stud/giây)
    ChaseHeight = 400,   -- độ cao phía trên đầu kẻ địch (tối đa 400)
    FlySpeed    = 70,
    WalkSpeed   = 60,
    JumpPower   = 130,
    ShootRange  = 1000,
    SwitchDelay = 2.5,
    AimSmooth   = 1,     -- 1 = khóa cứng, nhỏ hơn = mượt hơn
