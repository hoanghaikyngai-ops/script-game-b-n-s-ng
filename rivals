-- Đổi sang kẻ địch kế tiếp (vòng tròn, bỏ qua đồng đội). Chỉ chạy khi bật Aim camera.
local function toggleLock()
    if not CFG.AimLock then return end
    local myRoot = getRoot(LP)
    if not myRoot then return end

    local candidates = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and isAlive(p) and not skip(p) and not isTeammate(p) and not recentlyDead(p) then
            if (getRoot(p).Position - myRoot.Position).Magnitude <= CFG.ScanRange then
                table.insert(candidates, p)
            end
        end
    end
    if #candidates == 0 then State.LockedTarget = nil return end

    table.sort(candidates, function(a, b) return a.UserId < b.UserId end) -- thứ tự ổn định

    local idx = 0
    for i, p in ipairs(candidates) do
        if p == State.LockedTarget then idx = i break end
    end
    State.LockedTarget = candidates[idx % #candidates + 1]
    refreshLock()
end

-- Mở/khóa camera. Chỉ chạy khi bật Aim camera.
local function toggleCam()
    if not CFG.AimLock then return end
    State.CamFree = not State.CamFree
    refreshLock()
end

