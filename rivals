local espFrames = {}

local function clearESPFrame(p)
    local o = espFrames[p]
    if o then
        pcall(function() o.hl:Destroy() end)
        pcall(function() o.box:Destroy() end)
        pcall(function() o.tag:Destroy() end)
        if o.hb then for _, a in pairs(o.hb) do pcall(function() a:Destroy() end) end end
        espFrames[p] = nil
    end
end

-- Hộp hitbox 3D: vàng = đầu, xanh = thân (bám kích thước thật, kể cả khi đã phóng to)
local HB_PARTS = { "Head", "HumanoidRootPart" }
local function updateHitboxESP(o, p)
    o.hb = o.hb or {}
    local c = getChar(p)
    for _, name in ipairs(HB_PARTS) do
        local part = c and c:FindFirstChild(name)
        local a = o.hb[name]
        if CFG.HitboxESP and part and part:IsA("BasePart") then
            if not a or not a.Parent then
                a = Instance.new("BoxHandleAdornment")
                a.AlwaysOnTop = true
                a.ZIndex = 2
                a.Transparency = 0.55
                a.Color3 = (name == "Head") and Color3.fromRGB(255, 220, 0) or Color3.fromRGB(0, 200, 255)
                a.Parent = gui
                o.hb[name] = a
            end
            a.Adornee = part
            a.Size = part.Size
        elseif a then
            a:Destroy()
            o.hb[name] = nil
        end
    end
end

local function ensureESPFrame(p)
    local o = espFrames[p]
    local char = getChar(p)
    if o and o.hl.Adornee == char then return o end
    if o then clearESPFrame(p) end

    local hl = Instance.new("Highlight")
    hl.Name = "HHub_ESP"
    hl.Adornee = char
    hl.FillColor = Color3.fromRGB(255, 0, 0)
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = char

    local box = Instance.new("Frame")
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.ZIndex = 5
    box.Parent = gui
    local bstroke = Instance.new("UIStroke")
    bstroke.Thickness = 2
    bstroke.Color = Color3.fromRGB(255, 0, 0)
    bstroke.Parent = box

    local tag = Instance.new("TextLabel")
    tag.BackgroundTransparency = 1
    tag.Size = UDim2.new(1, 40, 0, 16)
    tag.Position = UDim2.new(0, -20, 0, -18)
    tag.Font = Enum.Font.GothamBold
    tag.TextSize = 12
    tag.TextColor3 = Color3.fromRGB(255, 70, 70)
    tag.TextStrokeTransparency = 0
    tag.ZIndex = 5
    tag.Parent = box

    local hpBack = Instance.new("Frame")
    hpBack.Size = UDim2.new(0, 3, 1, 0)
    hpBack.Position = UDim2.new(0, -6, 0, 0)
    hpBack.BackgroundColor3 = Color3.new(0, 0, 0)
    hpBack.BackgroundTransparency = 0.3
    hpBack.BorderSizePixel = 0
    hpBack.ZIndex = 5
    hpBack.Parent = box
    local hpFill = Instance.new("Frame")
    hpFill.Size = UDim2.new(1, 0, 1, 0)
    hpFill.BorderSizePixel = 0
    hpFill.BackgroundColor3 = Color3.fromRGB(0, 255, 90)
    hpFill.ZIndex = 6
    hpFill.Parent = hpBack

    o = { hl = hl, box = box, stroke = bstroke, tag = tag, hb = {}, hpBack = hpBack, hpFill = hpFill }
    espFrames[p] = o
    return o
end

