-- TIỆN ÍCH
---------------------------------------------------------------------
local conns = {}
local function bind(signal, fn)
    local c = signal:Connect(fn)
    table.insert(conns, c)
    return c
end

local function getChar(p) return p and p.Character end
local function getRoot(p) local c = getChar(p) return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum(p) local c = getChar(p) return c and c:FindFirstChildOfClass("Humanoid") end
local function isAlive(p) local h = getHum(p) return h and h.Health > 0 and getRoot(p) ~= nil end

local function isTeammate(p)
    return p.Team ~= nil and p.Team == LP.Team
end

-- Người vừa chết bị bỏ qua RespawnIgnore giây, để camera/đạn chuyển sang người kế tiếp
-- thay vì dính lại vào chính người đó khi họ hồi sinh ngay.
local deadUntil = setmetatable({}, { __mode = "k" })
local function recentlyDead(p)
    local t = deadUntil[p]
    return t ~= nil and os.clock() < t
end
local function skip(p) return CFG.TeamCheck and isTeammate(p) end

local function getNearest(maxRange)
    local myRoot = getRoot(LP)
    if not myRoot then return nil end
    local best, bestDist = nil, maxRange or math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        -- Aim camera bật -> luôn bỏ qua đồng đội, không cần bật "Bỏ qua team"
        if p ~= LP and isAlive(p) and not recentlyDead(p) and not skip(p) and not (CFG.AimLock and isTeammate(p)) then
            local d = (getRoot(p).Position - myRoot.Position).Magnitude
            if d < bestDist then best, bestDist = p, d end
        end
    end
    return best, bestDist
end

-- Cache mục tiêu (dùng khi Aim camera TẮT)
local cachedTarget, nextTargetScan = nil, 0
local TARGET_REFRESH = 0.05 -- quét mục tiêu mới nhanh hơn -> camera chuyển người gần như tức thì

local function validTarget(p)
    return p ~= nil and p.Parent == Players and isAlive(p) and not recentlyDead(p) and not skip(p)
end

local function getTarget()
    -- AIM CAMERA BẬT: giữ cứng 1 mục tiêu, chỉ chọn lại khi nó chết/thoát (hoặc bấm ĐỔI)
    if CFG.AimLock then
        local t = State.LockedTarget
        if t and t.Parent == Players and isAlive(t) and not isTeammate(t) and not recentlyDead(t) then
            return t
        end
        State.LockedTarget = nil
        local now = os.clock()
        if now >= nextTargetScan then
            nextTargetScan = now + TARGET_REFRESH
            State.LockedTarget = getNearest(CFG.ScanRange)
        end
        return State.LockedTarget
    end

    -- AIM CAMERA TẮT: logic cũ (đuổi/bắn người gần nhất, giữ tới khi tạch)
    State.LockedTarget = nil
    if validTarget(cachedTarget) then
        local myRoot, curRoot = getRoot(LP), getRoot(cachedTarget)
        if myRoot and curRoot and (curRoot.Position - myRoot.Position).Magnitude <= CFG.ScanRange then
            return cachedTarget
        end
    end

    local now = os.clock()
    if now >= nextTargetScan then
        nextTargetScan = now + TARGET_REFRESH
        cachedTarget = getNearest(CFG.ScanRange)
    end

    if validTarget(cachedTarget) then return cachedTarget end
    return nil
end

-- MỤC TIÊU CỦA "ĐẠN VỀ MỤC TIÊU": luôn là kẻ địch GẦN NHẤT, không khóa ai,
-- tự chuyển sang người gần hơn ngay khi có, luôn bỏ qua đồng đội
-- (chính là những người có màu đỏ trên ESP).
local silentTarget, silentNext = nil, 0
local function getSilentTarget()
    if silentTarget and (silentTarget.Parent ~= Players or not isAlive(silentTarget) or isTeammate(silentTarget) or recentlyDead(silentTarget)) then
        silentTarget, silentNext = nil, 0
    end
    local now = os.clock()
    if now >= silentNext then
        silentNext = now + 0.1
        local myRoot = getRoot(LP)
        local best, bestDist = nil, CFG.ScanRange
        if myRoot then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP and isAlive(p) and not isTeammate(p) and not recentlyDead(p) then
                    local d = (getRoot(p).Position - myRoot.Position).Magnitude
                    if d < bestDist then best, bestDist = p, d end
                end
            end
        end
        silentTarget = best
    end
    return silentTarget
end

local function getTools()
    local list = {}
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then for _, t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then table.insert(list, t) end end end
    local c = getChar(LP)
    if c then for _, t in ipairs(c:GetChildren()) do if t:IsA("Tool") then table.insert(list, t) end end end
    table.sort(list, function(a, b) return a.Name < b.Name end)
    return list
end

-- Đoán loại vũ khí: "Súng" hoặc "Dao", dựa theo tên Tool và tên các phần bên trong.
local function classifyToolRaw(tool)
    if not tool then return "?" end
    local n = tool.Name:lower()
    local gunWords  = { "gun", "rifle", "pistol", "smg", "shotgun", "sniper", "ak", "m4", "glock" }
    local bladeWords = { "knife", "sword", "blade", "dagger", "machete", "axe", "katana" }
    for _, w in ipairs(gunWords) do if n:find(w) then return "Súng" end end
    for _, w in ipairs(bladeWords) do if n:find(w) then return "Dao" end end
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("BasePart") then
            local dn = d.Name:lower()
            if dn:find("barrel") or dn:find("muzzle") or dn:find("scope") or dn:find("mag") then return "Súng" end
            if dn:find("blade") or dn:find("edge") then return "Dao" end
        end
    end
    return "?"
end

-- Cache kết quả theo Tool (trước đây GetDescendants chạy lại MỖI FRAME -> rất lag)
local toolTypeCache = setmetatable({}, { __mode = "k" })
local function classifyTool(tool)
    if not tool then return "?" end
    local c = toolTypeCache[tool]
    if not c then
        c = classifyToolRaw(tool)
        toolTypeCache[tool] = c
    end
    return c
end

-- Bấm/chạm thật vào giữa một nút trên màn hình (VirtualInputManager, không bị lệch tọa độ).
-- Cần gui.IgnoreGuiInset = true để AbsolutePosition khớp tọa độ màn hình.
local function screenClick(frame)
    if not frame or not frame.Parent then return end
    local pos = frame.AbsolutePosition + frame.AbsoluteSize / 2
    local x, y = pos.X, pos.Y

    local ok = pcall(function()
        local VIM = game:GetService("VirtualInputManager")
        if UIS.TouchEnabled and not UIS.MouseEnabled then
            VIM:SendTouchEvent(7, 0, x, y) -- chạm xuống
            task.delay(0.03, function() pcall(function() VIM:SendTouchEvent(7, 2, x, y) end) end) -- nhả
        else
            VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
            task.delay(0.03, function() pcall(function() VIM:SendMouseButtonEvent(x, y, 0, false, game, 0) end) end)
        end
    end)

    if not ok then -- executor không có VIM -> dùng cách cũ
        if mousemoveabs then pcall(mousemoveabs, x, y) end
        if mouse1click then
            pcall(mouse1click)
        elseif mouse1press and mouse1release then
            pcall(mouse1press)
            task.defer(function() pcall(mouse1release) end)
        end
    end
end

-- Dùng để in ra tham số thật của remote bắn khi bật "Log remote bắn".
local function dump(v, depth)
    depth = depth or 0
    if typeof(v) == "table" and depth < 3 then
        local parts = {}
        for k, x in pairs(v) do
            parts[#parts + 1] = tostring(k) .. " = " .. dump(x, depth + 1)
        end
        return "{ " .. table.concat(parts, ", ") .. " }"
    elseif typeof(v) == "Instance" then
        return "Instance<" .. v:GetFullName() .. ">"
    end
    return typeof(v) .. ":" .. tostring(v)
end

-- Quay camera nhìn vào điểm mà không bị lật khi nhìn thẳng lên/xuống.
local function safeLookAt(from, to)
    local dir = to - from
    if dir.Magnitude < 1e-3 then return Camera.CFrame end
    local up = Vector3.yAxis
    if math.abs(dir.Unit.Y) > 0.995 then
        local f = Camera.CFrame.LookVector
        local flat = Vector3.new(f.X, 0, f.Z)
        up = (flat.Magnitude > 1e-3) and flat.Unit or Vector3.zAxis
    end
    return CFrame.lookAt(from, to, up)
end

