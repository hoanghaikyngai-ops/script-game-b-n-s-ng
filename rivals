    AimPart     = "Head",

    -- Đạn về mục tiêu
    SilentMinRay       = 8,   -- tia ngắn hơn số này thì bỏ qua (đã hạ xuống để không sót tia của súng)
    SilentOriginRadius = 800, -- tia phải bắt đầu trong bán kính này quanh bạn/camera
    SilentRemote       = true, -- sửa tham số remote bắn về mục tiêu (ĐOÁN, xem log để chỉnh)

    EnemyHitboxSize = 12, EnemyHitboxPart = "HumanoidRootPart", EnemyHitboxTransp = 0.75,
