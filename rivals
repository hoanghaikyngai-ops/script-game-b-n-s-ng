env.__HHub = function()
    npcScanRunning = false
    for model in pairs(npcConns) do removeNPC(model) end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    pcall(function() RunService:UnbindFromRenderStep("HHub_Aim") end)
    pcall(function() RunService:UnbindFromRenderStep("HHub_ESP") end)
    releaseCamera()
    restoreCameraMode()
    pcall(setInvisible, false)
    pcall(function() if env.__HHubPartGodRestore then env.__HHubPartGodRestore() end end)
    pcall(function()
        local gh = getHum(LP)
        if gh then gh:SetStateEnabled(Enum.HumanoidStateType.Dead, true) end
    end)
    -- các hook (đã cài trên game) sẽ thấy các hàm này = nil và chạy như bình thường
    env.__HHubCamFix = nil
    env.__HHubSilent = nil
    env.__HHubRedirect = nil
    env.__HHubLog = nil
    env.__HHubPartGodRestore = nil
    for p in pairs(espFrames) do clearESPFrame(p) end
    restoreAllHB()
    setMapWhite(false)
    setFixLag(false)
    stopFly()
    pcall(function() gui:Destroy() end)
    local h = getHum(LP)
    if h then
        if origWalk then h.WalkSpeed = origWalk end
        if origJump then h.UseJumpPower, h.JumpPower = origJump[1], origJump[2] end
    end
    env.__HHub = nil
end
