-- NPC (quái/bot có Humanoid): quét định kỳ, bật bằng CFG.IncludeNPC
---------------------------------------------------------------------
local npcList = {}  -- [Model] = true
local npcConns = {} -- [Model] = { connection, ... }
local npcScanRunning = true

local function removeNPC(model)
    npcList[model] = nil
    local cs = npcConns[model]
    if cs then
        for _, c in ipairs(cs) do pcall(function() c:Disconnect() end) end
        npcConns[model] = nil
    end
end

local function isPlayerModel(model)
    return Players:GetPlayerFromCharacter(model) ~= nil or Players:FindFirstChild(model.Name) ~= nil
end

local function addNPC(model)
    if not model or npcList[model] or not model:IsA("Model") then return end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or isPlayerModel(model) then return end -- bỏ qua nhân vật người chơi
    npcList[model] = true
    npcConns[model] = {
        hum.Died:Connect(function() removeNPC(model) end),
        model.AncestryChanged:Connect(function(_, parent) if not parent then removeNPC(model) end end),
    }
end

local function refreshNPCList()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and not npcList[obj] and obj:FindFirstChildOfClass("Humanoid") then
            addNPC(obj)
        end
    end
end

task.spawn(function()
    while npcScanRunning do
        if CFG.IncludeNPC then pcall(refreshNPCList) end
        task.wait(1)
    end
end)

bind(Workspace.DescendantAdded, function(obj)
    if CFG.IncludeNPC and obj:IsA("Humanoid") then
        task.defer(function() pcall(addNPC, obj.Parent) end)
    end
end)

-- Danh sách mục tiêu gộp: người chơi khác (trừ mình) + NPC nếu bật "Quét cả NPC".
-- Luôn lấy danh sách Players MỚI NHẤT tại thời điểm gọi -> người vừa vào trận được tính ngay.
local function getAllTargets()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then table.insert(list, p) end
    end
    if CFG.IncludeNPC then
        for model in pairs(npcList) do
            if model.Parent then
                if isPlayerModel(model) then
                    removeNPC(model) -- hóa ra là nhân vật người chơi -> đã có trong danh sách người chơi
                else
                    table.insert(list, model)
                end
            end
        end
    end
    return list
end

local function pickRandomEnemy()
    local candidates = {}
    for _, p in ipairs(getAllTargets()) do
        if isEnemy(p) then table.insert(candidates, p) end
    end
    if #candidates == 0 then return nil end
    return candidates[math.random(1, #candidates)]
end

local function getTools()
    local list = {}
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then for _, t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then table.insert(list, t) end end end
    local c = getChar(LP)
    if c then for _, t in ipairs(c:GetChildren()) do if t:IsA("Tool") then table.insert(list, t) end end end
    table.sort(list, function(a, b) return a.Name < b.Name end)
    return list
end

local function classifyTool(tool)
    if not tool then return "?" end
    local n = tool.Name:lower()
    local gunWords  = { "gun", "rifle", "pistol", "smg", "shotgun", "sniper", "ak", "m4", "glock" }
    local bladeWords = { "knife", "sword", "blade", "dagger", "machete", "axe", "katana" }
    for _, w in ipairs(gunWords) do if n:find(w) then return "Súng" end end
    for _, w in ipairs(bladeWords) do if n:find(w) then return "Dao" end end
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("BasePart") then
            local dn = d.Name:lower()
            if dn:find("barrel") or dn:find("muzzle") or dn:find("scope") or dn:find("mag") then return "Súng" end
            if dn:find("blade") or dn:find("edge") then return "Dao" end
        end
    end
    return "?"
end

local function screenClick(frame)
    if not frame or not frame.Parent then return end
    local pos = frame.AbsolutePosition + frame.AbsoluteSize / 2
    if mousemoveabs then pcall(mousemoveabs, pos.X, pos.Y) end
    if mouse1click then
        pcall(mouse1click)
    elseif mouse1press and mouse1release then
        pcall(mouse1press)
        task.defer(function() pcall(mouse1release) end)
    end
end

local function dump(v, depth)
    depth = depth or 0
    if typeof(v) == "table" and depth < 3 then
        local parts = {}
        for k, x in pairs(v) do
            parts[#parts + 1] = tostring(k) .. " = " .. dump(x, depth + 1)
        end
        return "{ " .. table.concat(parts, ", ") .. " }"
    elseif typeof(v) == "Instance" then
        return "Instance<" .. v:GetFullName() .. ">"
    end
    return typeof(v) .. ":" .. tostring(v)
end

local function safeLookAt(from, to)
    local dir = to - from
    if dir.Magnitude < 1e-3 then return Camera.CFrame end
    local up = Vector3.yAxis
    if math.abs(dir.Unit.Y) > 0.995 then
        local f = Camera.CFrame.LookVector
        local flat = Vector3.new(f.X, 0, f.Z)
        up = (flat.Magnitude > 1e-3) and flat.Unit or Vector3.zAxis
    end
    return CFrame.lookAt(from, to, up)
end

