---------------------------------------------------------------------
-- TIỆN ÍCH
---------------------------------------------------------------------
local conns = {}
local function bind(signal, fn)
    local c = signal:Connect(fn)
    table.insert(conns, c)
    return c
end

local function getChar(p) return p and p.Character end
local function getRoot(p) local c = getChar(p) return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum(p) local c = getChar(p) return c and c:FindFirstChildOfClass("Humanoid") end
local function isAlive(p) local h = getHum(p) return h and h.Health > 0 and getRoot(p) ~= nil end
local function skip(p) return CFG.TeamCheck and p.Team ~= nil and p.Team == LP.Team end

local function getNearest(maxRange)
    local myRoot = getRoot(LP)
    if not myRoot then return nil end
    local best, bestDist = nil, maxRange or math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and isAlive(p) and not skip(p) then
            local d = (getRoot(p).Position - myRoot.Position).Magnitude
            if d < bestDist then best, bestDist = p, d end
        end
    end
    return best, bestDist
end

local function getTarget()
    local locked = State.LockedTarget
    if locked then
        if locked.Parent == Players and isAlive(locked) then return locked end
        State.LockedTarget = nil
    end
    return (getNearest())
end

local function getTools()
    local list = {}
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then for _, t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then table.insert(list, t) end end end
    local c = getChar(LP)
    if c then for _, t in ipairs(c:GetChildren()) do if t:IsA("Tool") then table.insert(list, t) end end end
    table.sort(list, function(a, b) return a.Name < b.Name end)
    return list
end

---------------------------------------------------------------------
-- ESP (đỏ, xuyên tường)
---------------------------------------------------------------------
local espObjs = {}

local function clearESP(p)
    local o = espObjs[p]
    if o then
        for _, inst in pairs(o) do pcall(function() inst:Destroy() end) end
        espObjs[p] = nil
    end
end

local function updateESP(target)
    local myRoot = getRoot(LP)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local char, root = getChar(p), getRoot(p)
            if CFG.ESP and char and root and isAlive(p) and not skip(p) then
                local o = espObjs[p]
                if not o or not o.hl.Parent or not o.bb.Parent or o.hl.Adornee ~= char then
                    clearESP(p)
                    local hl = Instance.new("Highlight")
                    hl.Name = "HHub_ESP"
                    hl.Adornee = char
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = char

                    local bb = Instance.new("BillboardGui")
                    bb.Name = "HHub_Tag"
                    bb.Adornee = root
                    bb.AlwaysOnTop = true
                    bb.Size = UDim2.new(0, 160, 0, 34)
                    bb.StudsOffset = Vector3.new(0, 3.5, 0)
                    bb.Parent = root
                    local tl = Instance.new("TextLabel")
                    tl.BackgroundTransparency = 1
                    tl.Size = UDim2.fromScale(1, 1)
                    tl.Font = Enum.Font.GothamBold
                    tl.TextSize = 14
                    tl.TextColor3 = Color3.fromRGB(255, 60, 60)
                    tl.TextStrokeTransparency = 0
                    tl.Parent = bb
                    o = { hl = hl, bb = bb, tl = tl }
                    espObjs[p] = o
                end
                local isTarget = (p == target)
                o.hl.FillTransparency = isTarget and 0.15 or 0.55
                local dist = myRoot and math.floor((root.Position - myRoot.Position).Magnitude) or 0
                o.tl.Text = (isTarget and "🎯 " or "") .. p.DisplayName .. " [" .. dist .. "]"
            else
                clearESP(p)
            end
        end
    end
end

bind(Players.PlayerRemoving, function(p)
    clearESP(p)
    if State.LockedTarget == p then State.LockedTarget = nil end
end)

---------------------------------------------------------------------
-- BAY
---------------------------------------------------------------------
local flyBV, flyBG
local function stopFly()
    if flyBV then flyBV:Destroy() flyBV = nil end
    if flyBG then flyBG:Destroy() flyBG = nil end
end

local function doFly(root, hum)
    if not flyBV or flyBV.Parent ~= root or not flyBG or flyBG.Parent ~= root then
        stopFly()
        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        flyBV.Velocity = Vector3.zero
        flyBV.Parent = root
        flyBG = Instance.new("BodyGyro")
        flyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        flyBG.P = 1e4
        flyBG.Parent = root
    end
    local cf = Camera.CFrame
    local rel = cf:VectorToObjectSpace(hum.MoveDirection)
    local vel = cf.LookVector * (-rel.Z) + cf.RightVector * rel.X
    if UIS:IsKeyDown(Enum.KeyCode.Space) then vel += Vector3.new(0, 1, 0) end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
        vel -= Vector3.new(0, 1, 0)
    end
    flyBV.Velocity = vel * CFG.FlySpeed
    local look = cf.LookVector
    flyBG.CFrame = CFrame.lookAt(root.Position, root.Position + Vector3.new(look.X, 0, look.Z))
end

