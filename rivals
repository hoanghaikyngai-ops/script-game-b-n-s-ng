-- ESP (đỏ, XUYÊN TƯỜNG)
-- Mọi vật ESP nằm trong espFolder (trong GUI của hub) chứ không gắn vào nhân vật,
-- nên game không xóa được và vẫn thấy xuyên vật thể.
---------------------------------------------------------------------
local gui, espFolder -- tạo ở phần giao diện bên dưới
local espObjs = {}

local function clearESP(p)
    local o = espObjs[p]
    if o then
        for _, inst in pairs(o) do pcall(function() inst:Destroy() end) end
        espObjs[p] = nil
    end
end

local function updateESP(target)
    local myRoot = getRoot(LP)
    if not CFG.ESP or not espFolder then
        for p in pairs(espObjs) do clearESP(p) end
        return
    end

    local allowed, cand = {}, {}
    if myRoot then
        for _, p in ipairs(Players:GetPlayers()) do
            if isEnemy(p) and not skip(p) then
                table.insert(cand, { p = p, d = (getRoot(p).Position - myRoot.Position).Magnitude })
            end
        end
        table.sort(cand, function(a, b) return a.d < b.d end)
        for i = 1, math.min(CFG.ESPMax, #cand) do allowed[cand[i].p] = true end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local char, root = getChar(p), getRoot(p)
            if allowed[p] and char and root then
                local o = espObjs[p]
                if not o or not o.hl.Parent or not o.bb.Parent or not o.box.Parent
                    or o.hl.Adornee ~= char or o.box.Adornee ~= root then
                    clearESP(p)

                    local hl = Instance.new("Highlight")
                    hl.Name = "HHub_ESP"
                    hl.Adornee = char
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = espFolder

                    -- hộp dự phòng: vẫn thấy xuyên tường kể cả khi Highlight bị giới hạn/không vẽ
                    local box = Instance.new("BoxHandleAdornment")
                    box.Name = "HHub_Box"
                    box.Adornee = root
                    box.Size = Vector3.new(4, 6, 2)
                    box.Color3 = Color3.fromRGB(255, 0, 0)
                    box.Transparency = 0.55
                    box.AlwaysOnTop = true
                    box.ZIndex = 5
                    box.Parent = espFolder

                    local bb = Instance.new("BillboardGui")
                    bb.Name = "HHub_Tag"
                    bb.Adornee = root
                    bb.AlwaysOnTop = true
                    bb.Size = UDim2.new(0, 160, 0, 34)
                    bb.StudsOffset = Vector3.new(0, 3.5, 0)
                    bb.Parent = espFolder
                    local tl = Instance.new("TextLabel")
                    tl.BackgroundTransparency = 1
                    tl.Size = UDim2.fromScale(1, 1)
                    tl.Font = Enum.Font.GothamBold
                    tl.TextSize = 14
                    tl.TextColor3 = Color3.fromRGB(255, 60, 60)
                    tl.TextStrokeTransparency = 0
                    tl.Parent = bb
                    o = { hl = hl, box = box, bb = bb, tl = tl }
                    espObjs[p] = o
                end
                local isTarget = (p == target) or (CFG.SilentAim and p == silentTarget)
                o.hl.FillTransparency = isTarget and 0.15 or 0.55
                o.box.Transparency = isTarget and 0.3 or 0.65
                local dist = myRoot and math.floor((root.Position - myRoot.Position).Magnitude) or 0
                local txt = (isTarget and "🎯 " or "") .. p.DisplayName .. " [" .. dist .. "]"
                if o.tl.Text ~= txt then o.tl.Text = txt end
            else
                clearESP(p)
            end
        end
    end
end

bind(Players.PlayerRemoving, function(p)
    clearESP(p)
    if State.PlayerLock == p then State.PlayerLock = nil end
end)

