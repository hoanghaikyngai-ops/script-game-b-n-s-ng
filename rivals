local function get2DBox(p)
    local head, root = getAimPart(p), getRoot(p)
    if not head or not root then return nil end
    Camera = Workspace.CurrentCamera or Camera
    if not Camera then return nil end

    local topScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.4, 0))
    if topScreen.Z <= 0 then return nil end

    local botScreen = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3.2, 0))
    local height, centerX, topY
    if botScreen.Z > 0 then
        height = math.max(math.abs(botScreen.Y - topScreen.Y), 6)
        centerX = (topScreen.X + botScreen.X) / 2
        topY = math.min(topScreen.Y, botScreen.Y)
    else
        local dist = math.max((root.Position - Camera.CFrame.Position).Magnitude, 1)
        height = math.clamp(4000 / dist, 10, 500)
        centerX, topY = topScreen.X, topScreen.Y
    end
    local width = height * 0.55

    return {
        pos = Vector2.new(centerX - width / 2, topY),
        size = Vector2.new(width, height),
        center = Vector2.new(centerX, topY + height / 2),
        aimPoint = head.Position,
        dist = (root.Position - Camera.CFrame.Position).Magnitude,
    }
end

-- Kiểm tra tầm nhìn: tia từ camera tới mục tiêu, chạm phần thân của chính người đó = thấy được
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function isVisible(p, part)
    Camera = Workspace.CurrentCamera or Camera
    if not Camera then return true end
    local ignore = { Camera }
    local myChar = getChar(LP)
    if myChar then table.insert(ignore, myChar) end
    rayParams.FilterDescendantsInstances = ignore
    local origin = Camera.CFrame.Position
    local hit = Workspace:Raycast(origin, part.Position - origin, rayParams)
    if not hit then return true end
    local c = getChar(p)
    return c ~= nil and hit.Instance:IsDescendantOf(c)
end

-- Mục tiêu tự động đang bám (khác với khóa tay State.LockedTarget) + ngưỡng chống nhảy qua lại
local autoTarget = nil
local SWITCH_MARGIN = 0.92 -- mục tiêu đang bám được ưu tiên thêm để khỏi nhảy qua lại

local function pickScreenTarget()
    if State.LockedTarget and isEnemy(State.LockedTarget) then
        return State.LockedTarget, get2DBox(State.LockedTarget)
    end
    State.LockedTarget = nil

    Camera = Workspace.CurrentCamera or Camera
    if not Camera then return nil end
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local camPos = Camera.CFrame.Position

    local best, bestDist = nil, math.huge
    for _, p in ipairs(getAllTargets()) do
        if isEnemy(p) then
            local part = getAimPart(p)
            if part then
                local dist = (part.Position - camPos).Magnitude
                if dist <= CFG.ScanRange then
                    local v = Camera:WorldToViewportPoint(part.Position)
                    local sd = (Vector2.new(v.X, v.Y) - center).Magnitude
                    local inFov = v.Z > 0 and sd <= CFG.FOVRadius
                    if (inFov or CFG.AimAnywhere) and (not CFG.VisCheck or isVisible(p, part)) then
                        local score = dist
                        if CFG.CrosshairPriority then
                            score = (v.Z > 0) and sd or (100000 + dist) -- người sau lưng xếp cuối
                        end
                        if p == autoTarget then score = score * SWITCH_MARGIN end
                        if score < bestDist then best, bestDist = p, score end
                    end
                end
            end
        end
    end
    autoTarget = best
    return best, best and get2DBox(best)
end

