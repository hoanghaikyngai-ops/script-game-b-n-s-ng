-- AIM: chiếm camera (Scriptable) hoặc aim bằng chuột
-- ESP chạy TRƯỚC aim (priority thấp hơn 1) để tính khung bằng camera gốc
---------------------------------------------------------------------
local AIM_PRIORITY = 2000000000
local ESP_PRIORITY = AIM_PRIORITY - 1

-- Aim bằng chuột: di chuột một phần độ lệch giữa địch và tâm màn hình mỗi khung
local function aimWithMouse(aimPos)
    local vp = Camera.ViewportSize
    local v = Camera:WorldToViewportPoint(aimPos)
    local dx, dy
    if v.Z > 0 then
        dx, dy = v.X - vp.X / 2, v.Y - vp.Y / 2
    else -- địch ở sau lưng: quay ngang về phía có địch
        local rel = Camera.CFrame:PointToObjectSpace(aimPos)
        dx, dy = (rel.X >= 0) and 400 or -400, 0
    end
    local g = math.clamp(CFG.AimSpeed / 100, 0.05, 1) * CFG.MouseGain
    local m = CFG.MouseMaxStep
    mousemoverel(math.clamp(dx * g, -m, m), math.clamp(dy * g, -m, m))
end

local camTypeBackup, lastWritten, warnedOverride = nil, nil, false

local function releaseCamera()
    if camTypeBackup then
        pcall(function() Camera.CameraType = camTypeBackup end)
        camTypeBackup = nil
    end
    lastWritten = nil
end

RunService:BindToRenderStep("HHub_Aim", AIM_PRIORITY, function()
    Camera = Workspace.CurrentCamera or Camera
    if not Camera then return end

    -- chẩn đoán: camera đầu khung khác với cái mình vừa ghi => game ghi đè
    if lastWritten and not warnedOverride
        and Camera.CFrame.LookVector:Dot(lastWritten.LookVector) < 0.98 then
        warnedOverride = true
        warn("[H Hub] Game đang ghi đè camera sau script (bị đẩy khỏi mục tiêu).")
    end

    local target = pickScreenTarget()
    State.SelectedTarget = target
    if relockUntil > 0 then
        if tick() > relockUntil then
            relockUntil = 0
        elseif target and not State.LockedTarget then
            State.LockedTarget = target -- người bị khóa vừa chết -> khóa sang người kế tiếp
            relockUntil = 0
        end
    end

    if not CFG.AimLock or not target then releaseCamera() return end
    local part = getAimPart(target)
    if not part then return end
    local aimPos = getLeadPos(part, Camera.CFrame.Position)

    -- chuột chỉ dùng khi bạn chủ động bật (PC, chuột khóa giữa màn hình)
    if CFG.AimMouse and mousemoverel then
        releaseCamera()
        aimWithMouse(aimPos)
        return
    end

    -- hook đang chạy tốt (vừa sửa lệnh ghi camera của game) => không cần chiếm camera
    if env.__HHubCamHookOk and CFG.CamHook and (tick() - (env.__HHubHookTick or 0)) < 0.5 then
        releaseCamera()
        return
    end

    -- chiếm camera: ngăn camera mặc định ghi đè (dự phòng khi hook không ăn)
    if Camera.CameraType ~= Enum.CameraType.Scriptable then
        camTypeBackup = camTypeBackup or Camera.CameraType
        Camera.CameraType = Enum.CameraType.Scriptable
    end

    local want = safeLookAt(Camera.CFrame.Position, aimPos)
    local nf = (CFG.AimSpeed >= 100) and want or Camera.CFrame:Lerp(want, CFG.AimSpeed / 100)
    Camera.CFrame = nf
    lastWritten = nf
end)

