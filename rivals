local function camFix(cf)
    if not (CFG.CamHook and CFG.AimLock) or CFG.AimMouse then return nil end
    local target = State.SelectedTarget
    local part = target and getAimPart(target)
    if not part then return nil end
    local pos = cf.Position
    local want = safeLookAt(pos, getLeadPos(part, pos))
    if CFG.AimSpeed >= 100 then return want end
    return cf:Lerp(want, CFG.AimSpeed / 100)
end
