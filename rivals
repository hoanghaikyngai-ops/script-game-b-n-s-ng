-- GOD: TẮT BỘ PHẬN (phía client)
-- Tắt CanTouch/CanQuery (và CanCollide trừ HumanoidRootPart) của mọi bộ phận nhân vật, bỏ qua vũ khí.
-- LƯU Ý: client KHÔNG gửi các thuộc tính này lên server -> game tính sát thương ở server vẫn trúng bạn.
---------------------------------------------------------------------
do
    local orig = setmetatable({}, { __mode = "k" })
    local timer = 0

    local function restore()
        for part, o in pairs(orig) do
            pcall(function()
                part.CanTouch, part.CanQuery, part.CanCollide = o[1], o[2], o[3]
            end)
            orig[part] = nil
        end
    end

    bind(RunService.Heartbeat, function(dt)
        timer += dt
        if timer < 0.1 then return end
        timer = 0
        if not CFG.PartGod then
            if next(orig) ~= nil then restore() end
            return
        end
        local c = getChar(LP)
        if not c then return end
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("BasePart") and not d:FindFirstAncestorOfClass("Tool") then
                if not orig[d] then orig[d] = { d.CanTouch, d.CanQuery, d.CanCollide } end
                d.CanTouch = false
                d.CanQuery = false
                if d.Name ~= "HumanoidRootPart" then d.CanCollide = false end
            end
        end
    end)

    env.__HHubPartGodRestore = restore
end

