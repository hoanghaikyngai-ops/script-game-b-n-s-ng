local originalMapColors = setmetatable({}, { __mode = "k" })
local mapRun = 0 -- đánh số lần chạy: lệnh mới luôn thay lệnh cũ (không bị nuốt)

local function isCharacterOrToolPart(part)
    local model = part:FindFirstAncestorOfClass("Model")
    if model and model:FindFirstChildOfClass("Humanoid") then return true end
    local tool = part:FindFirstAncestorOfClass("Tool")
    return tool ~= nil
end

local function setMapWhite(enabled)
    mapRun += 1
    local my = mapRun
    task.spawn(function()
        local count = 0
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if my ~= mapRun then return end
            if obj:IsA("BasePart") and not isCharacterOrToolPart(obj) then
                if enabled then
                    if originalMapColors[obj] == nil then originalMapColors[obj] = obj.Color end
                    obj.Color = Color3.new(1, 1, 1)
                elseif originalMapColors[obj] ~= nil then
                    obj.Color = originalMapColors[obj]
                    originalMapColors[obj] = nil
                end
                count += 1
                if count % 250 == 0 then task.wait() end
            end
        end
    end)
end

local function isHeavyVisual(obj)
    return obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
        or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles")
        or obj:IsA("PostEffect") or obj:IsA("PointLight") or obj:IsA("SpotLight")
        or obj:IsA("SurfaceLight") or obj:IsA("Clouds")
end

local lagState = setmetatable({}, { __mode = "k" }) -- [obj] = giá trị gốc để khôi phục
local lagGlobal = nil                               -- giá trị gốc của Lighting / Terrain / chất lượng đồ họa
local lagRun = 0                                    -- đánh số lần chạy để bỏ vòng cũ khi bật/tắt liên tục

local function lagApply(obj)
    if lagState[obj] then return end
    if obj:IsA("Terrain") then return end
    if obj:IsA("BasePart") then
        if isCharacterOrToolPart(obj) then return end
        lagState[obj] = { m = obj.Material, r = obj.Reflectance, s = obj.CastShadow }
        obj.Material = Enum.Material.SmoothPlastic
        obj.Reflectance = 0
        obj.CastShadow = false
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        if isCharacterOrToolPart(obj) then return end
        lagState[obj] = { t = obj.Transparency }
        obj.Transparency = 1
    elseif isHeavyVisual(obj) then
        lagState[obj] = { e = obj.Enabled }
        obj.Enabled = false
    end
end

local function lagRestore(obj, st)
    if st.m ~= nil then
        obj.Material, obj.Reflectance, obj.CastShadow = st.m, st.r, st.s
    elseif st.t ~= nil then
        obj.Transparency = st.t
    elseif st.e ~= nil then
        obj.Enabled = st.e
    end
end

local function setFixLag(enabled)
    local Lighting = game:GetService("Lighting")
    local Terrain = Workspace:FindFirstChildOfClass("Terrain")
    lagRun += 1
    local myRun = lagRun

    if enabled then
        if not lagGlobal then
            lagGlobal = {
                shadows = Lighting.GlobalShadows, fogEnd = Lighting.FogEnd,
                spec = Lighting.EnvironmentSpecularScale, diff = Lighting.EnvironmentDiffuseScale,
                atmos = {},
            }
            pcall(function() lagGlobal.tech = Lighting.Technology end)
            pcall(function() lagGlobal.soft = Lighting.ShadowSoftness end)
            pcall(function() lagGlobal.quality = settings().Rendering.QualityLevel end)
            if Terrain then
                pcall(function()
                    lagGlobal.water = { Terrain.WaterWaveSize, Terrain.WaterWaveSpeed,
                        Terrain.WaterReflectance, Terrain.WaterTransparency }
                end)
                if gethiddenproperty then
                    pcall(function() lagGlobal.deco = gethiddenproperty(Terrain, "Decoration") end)
                end
            end
            for _, a in ipairs(Lighting:GetChildren()) do
                if a:IsA("Atmosphere") then
                    lagGlobal.atmos[a] = { a.Density, a.Haze, a.Glare }
                end
            end
        end

        -- ánh sáng + hiệu ứng toàn cục
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.EnvironmentSpecularScale = 0
        Lighting.EnvironmentDiffuseScale = 0
        pcall(function() Lighting.ShadowSoftness = 0 end)
        if sethiddenproperty then
            pcall(sethiddenproperty, Lighting, "Technology", Enum.Technology.Compatibility)
        end
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
        for a in pairs(lagGlobal.atmos) do
            pcall(function() a.Density, a.Haze, a.Glare = 0, 0, 0 end)
        end

        -- nước + cỏ trang trí của Terrain
        if Terrain then
            pcall(function()
                Terrain.WaterWaveSize = 0
                Terrain.WaterWaveSpeed = 0
                Terrain.WaterReflectance = 0
            end)
            if sethiddenproperty then pcall(sethiddenproperty, Terrain, "Decoration", false) end
        end

        -- vật thể: chia nhỏ ra nhiều khung để không giật khi vừa bật
        local count = 0
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if myRun ~= lagRun then return end
            pcall(lagApply, obj)
            count += 1
            if count % 400 == 0 then task.wait() end
        end
        for _, obj in ipairs(Lighting:GetDescendants()) do
            pcall(lagApply, obj)
        end
    else
        if lagGlobal then
            local g = lagGlobal
            Lighting.GlobalShadows = g.shadows
            Lighting.FogEnd = g.fogEnd
            Lighting.EnvironmentSpecularScale = g.spec
            Lighting.EnvironmentDiffuseScale = g.diff
            if g.soft then pcall(function() Lighting.ShadowSoftness = g.soft end) end
            if g.tech and sethiddenproperty then pcall(sethiddenproperty, Lighting, "Technology", g.tech) end
            if g.quality then pcall(function() settings().Rendering.QualityLevel = g.quality end) end
            for a, v in pairs(g.atmos) do
                pcall(function() a.Density, a.Haze, a.Glare = v[1], v[2], v[3] end)
            end
            if Terrain then
                if g.water then
                    pcall(function()
                        Terrain.WaterWaveSize, Terrain.WaterWaveSpeed = g.water[1], g.water[2]
                        Terrain.WaterReflectance, Terrain.WaterTransparency = g.water[3], g.water[4]
                    end)
                end
                if g.deco ~= nil and sethiddenproperty then
                    pcall(sethiddenproperty, Terrain, "Decoration", g.deco)
                end
            end
            lagGlobal = nil
        end
        for obj, st in pairs(lagState) do
            pcall(lagRestore, obj, st)
            lagState[obj] = nil
        end
    end
end

