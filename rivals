local hbOrig = setmetatable({}, { __mode = "k" })

local function setHB(part, on, size, transp)
    if not part or not part:IsA("BasePart") then return end
    if on then
        if not hbOrig[part] then
            hbOrig[part] = { Size = part.Size, Transparency = part.Transparency, CanCollide = part.CanCollide }
        end
        part.Size = size
        part.Transparency = transp
        part.CanCollide = false
    else
        local o = hbOrig[part]
        if o then
            part.Size, part.Transparency, part.CanCollide = o.Size, o.Transparency, o.CanCollide
            hbOrig[part] = nil
        end
    end
end

local function restoreAllHB()
    for part, o in pairs(hbOrig) do
        pcall(function() part.Size, part.Transparency, part.CanCollide = o.Size, o.Transparency, o.CanCollide end)
        hbOrig[part] = nil
    end
end

local hbTimer = 0
bind(RunService.Heartbeat, function(dt)
    hbTimer += dt
    if hbTimer < 0.25 then return end
    hbTimer = 0

    local s = Vector3.new(CFG.EnemyHitboxSize, CFG.EnemyHitboxSize, CFG.EnemyHitboxSize)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local c = getChar(p)
            local part = c and c:FindFirstChild(CFG.EnemyHitboxPart)
            if part then
                local myRoot, enemyRoot = getRoot(LP), getRoot(p)
                local inRange = myRoot and enemyRoot and (enemyRoot.Position - myRoot.Position).Magnitude <= CFG.ScanRange
                setHB(part, CFG.HitboxEnemy and inRange and isEnemy(p), s, CFG.EnemyHitboxTransp)
            end
        end
    end

    if CFG.HitboxWeapon then
        local ws = Vector3.new(CFG.WeaponHitboxSize, CFG.WeaponHitboxSize, CFG.WeaponHitboxSize)
        local myChar = getChar(LP)
        for _, tool in ipairs(getTools()) do
            local on = myChar ~= nil and tool.Parent == myChar
            for _, d in ipairs(tool:GetDescendants()) do
                if d:IsA("BasePart") and (d.Name == "Handle" or d.Name:lower():find("hitbox")) then
                    setHB(d, on, ws, CFG.WeaponHitboxTransp)
                end
            end
        end
    else
        for part in pairs(hbOrig) do
            if part:FindFirstAncestorOfClass("Tool") then setHB(part, false) end
        end
    end
end)

