local origWalk, origJump
local switchIdx, switchTimer, shootTimer = 0, 0, 0
local menuVisible = true
local statusLabel

bind(RunService.Heartbeat, function(dt)
    local myChar = getChar(LP)
    State.HasTool = myChar ~= nil and myChar:FindFirstChildOfClass("Tool") ~= nil

    local root, hum = getRoot(LP), getHum(LP)
    if hum then godStep(hum) end -- god mode chạy trước, kể cả khi máu đã về 0
    if not root or not hum or hum.Health <= 0 then
        stopFly()
        if statusLabel then statusLabel.Text = "Đang chết / chưa hồi sinh" end
        return
    end

    if CFG.Speed then
        origWalk = origWalk or hum.WalkSpeed
        hum.WalkSpeed = CFG.WalkSpeed
    elseif origWalk then
        hum.WalkSpeed = origWalk origWalk = nil
    end
    if CFG.HighJump then
        origJump = origJump or { hum.UseJumpPower, hum.JumpPower }
        hum.UseJumpPower = true
        hum.JumpPower = CFG.JumpPower
    elseif origJump then
        hum.UseJumpPower, hum.JumpPower = origJump[1], origJump[2] origJump = nil
    end

    -- mục tiêu được chọn trong RenderStep (HHub_Aim), ở đây chỉ đọc lại
    local target = State.SelectedTarget
    if target and not isEnemy(target) then target = nil end -- mục tiêu vừa chết -> bỏ ngay
    local targetBox = target and get2DBox(target)

    -- tự đuổi: tele sát sau lưng (mặc định) hoặc tele dưới chân (TeleGround)
    local chasing = false
    if CFG.Chase and target then
        local tRoot = getRoot(target)
        if tRoot and (tRoot.Position - root.Position).Magnitude <= CFG.ScanRange then
            chasing = true
            stopFly()
            if CFG.TeleGround then
                local pos = tRoot.Position - Vector3.new(0, CFG.GroundDepth, 0)
                root.CFrame = CFrame.new(pos)
            else
                local facing = tRoot.CFrame.LookVector
                if facing.Magnitude < 1e-3 then facing = Vector3.new(0, 0, -1) end
                local pos = tRoot.Position - facing * CFG.BehindDistance
                root.CFrame = CFrame.lookAt(pos, tRoot.Position)
            end
            root.AssemblyLinearVelocity = Vector3.zero
        end
    end
    if not chasing and CFG.Fly then doFly(root, hum) elseif not chasing then stopFly() end

    -- tự bắn
    if CFG.AutoShoot and target then
        shootTimer += dt
        local tRoot = getRoot(target)
        if shootTimer >= 0.06 and tRoot and (tRoot.Position - root.Position).Magnitude <= CFG.ShootRange then
            shootTimer = 0
            local tool = myChar:FindFirstChildOfClass("Tool")
            if CFG.UseCombatRemote and CombatRemote then
                pcall(function() CombatRemote:FireServer(CFG.CombatAction, target, tRoot.Position) end)
            elseif tool then
                pcall(function() tool:Activate() end)
                if not menuVisible then pcall(mouse1click) end
            end
            screenClick(env.__HHubAutoClickBtn)
        end
    end

    -- tự đổi súng
    if CFG.AutoSwitch then
        switchTimer += dt
        if switchTimer >= CFG.SwitchDelay then
            switchTimer = 0
            local tools = getTools()
            if #tools > 0 then
                switchIdx = switchIdx % #tools + 1
                pcall(function() hum:EquipTool(tools[switchIdx]) end)
                screenClick(env.__HHubSwitchClickBtn)
            end
        end
    end

    if statusLabel then
        if target then
            local d = targetBox and math.floor(targetBox.dist) or 0
            local wType = classifyTool(myChar and myChar:FindFirstChildOfClass("Tool"))
            statusLabel.Text = (State.LockedTarget and "🔒 " or "👁 ") .. getDisplayName(target) .. " [" .. d .. "] " .. wType .. (chasing and (CFG.TeleGround and " ⬇" or " 🗡") or "")
        else
            statusLabel.Text = "Không có mục tiêu"
        end
    end
end)

-- Điểm nhắm có bắn đón đầu: xa thì nhắm thân + cộng thời gian đạn bay + ping
local function getLeadPos(part, fromPos)
    local dist = (part.Position - fromPos).Magnitude
    if CFG.FarTorsoDist > 0 and dist > CFG.FarTorsoDist and part.Name == "Head" then
        local c = part.Parent
        local torso = c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso"))
        if torso then part = torso end
    end
    local lead = CFG.Predict
    if CFG.BulletSpeed > 0 then lead += dist / CFG.BulletSpeed end
    if CFG.UsePing then
        local okp, ping = pcall(function() return LP:GetNetworkPing() end)
        if okp and ping then lead += ping end
    end
    lead = math.min(lead, 1)
    local vel = part.AssemblyLinearVelocity
    if vel.Magnitude > 120 then vel = vel.Unit * 120 end
    return part.Position + vel * lead
end

