-- NGƯỜI CHẾT: bị BỎ QUA DEAD_IGNORE_SECONDS giây (mọi người chết đều tính riêng), hết giờ kiểm tra lại
---------------------------------------------------------------------
local deadIgnoreUntil = setmetatable({}, { __mode = "k" })
local DEAD_IGNORE_SECONDS = 3
local DEAD_ATTRS = { "Dead", "IsDead", "Died", "Downed", "Knocked" } -- thuộc tính game hay dùng để đánh dấu chết

local function markDead(p)
    if p ~= nil then deadIgnoreUntil[p] = tick() + DEAD_IGNORE_SECONDS end
end

-- true = đã chết (máu <= ngưỡng %, state Dead, mất nhân vật/Humanoid, hoặc game đánh dấu chết bằng thuộc tính)
local function readDead(p)
    local c = getChar(p)
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if not h or getRoot(p) == nil then return true end
    if h:GetState() == Enum.HumanoidStateType.Dead then return true end
    local maxH = h.MaxHealth
    local pct = (maxH and maxH > 0) and (h.Health / maxH * 100) or h.Health
    if pct <= CFG.DeadThresholdPct then return true end
    for _, n in ipairs(DEAD_ATTRS) do
        if c:GetAttribute(n) == true then return true end
        if isPlayerEntity(p) and p:GetAttribute(n) == true then return true end
    end
    return false
end

local function isAlive(p)
    local ig = deadIgnoreUntil[p]
    if ig and tick() < ig then return false end -- đang trong thời gian bỏ qua
    if readDead(p) then
        markDead(p) -- hết thời gian mà vẫn chết -> bỏ qua thêm một lượt nữa
        return false
    end
    return true -- sống lại / máu hồi -> được nhắm lại
end

