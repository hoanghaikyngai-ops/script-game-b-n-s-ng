-- PlayerLock: người đang bị khóa cứng (nil = lia theo người gần nhất)
-- Current: mục tiêu hiện tại (để nút khóa biết khóa ai)
local State = { PlayerLock = nil, Current = nil, HasTool = false, CamFree = false }

local CombatRemote = nil
do
    local ok, ev = pcall(function()
        return game:GetService("ReplicatedStorage").Remote.Event.Game["[C-S]SyncCombatAction"]
    end)
    if ok then CombatRemote = ev end
    if not CombatRemote then
        warn("[H Hub] Không tìm thấy remote [C-S]SyncCombatAction -> 'Dùng remote bắn' / 'Đạn: sửa remote' không hoạt động.")
    end
end

