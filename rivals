local hbOrig = setmetatable({}, { __mode = "k" })

local function setHB(part, on, size, transp)
    if not part or not part:IsA("BasePart") then return end
    if on then
        if not hbOrig[part] then
            hbOrig[part] = { Size = part.Size, Transparency = part.Transparency, CanCollide = part.CanCollide,
                Massless = part.Massless, CanQuery = part.CanQuery, CanTouch = part.CanTouch }
        end
        if part.Size ~= size then part.Size = size end -- game reset thì tự phóng lại
        if transp then part.Transparency = transp end
        part.CanCollide = false
        part.Massless = true
        part.CanQuery = true
        part.CanTouch = true
    else
        local o = hbOrig[part]
        if o then
            part.Size, part.Transparency, part.CanCollide = o.Size, o.Transparency, o.CanCollide
            part.Massless, part.CanQuery, part.CanTouch = o.Massless, o.CanQuery, o.CanTouch
            hbOrig[part] = nil
        end
    end
end

local function restoreAllHB()
    for part in pairs(hbOrig) do pcall(setHB, part, false) end
end

-- Hitbox địch: chạy MỖI KHUNG khi đang bật (hoặc còn phần chưa khôi phục), phóng cả thân lẫn đầu
bind(RunService.Heartbeat, function()
    if not CFG.HitboxEnemy and next(hbOrig) == nil then return end -- tắt hẳn: khỏi tốn CPU
    local myRoot = getRoot(LP)
    local s = CFG.EnemyHitboxSize
    local body, headS = Vector3.new(s, s, s), Vector3.new(s * 0.75, s * 0.75, s * 0.75)
    for _, p in ipairs(getAllTargets()) do
        local c = getChar(p)
        if c then
            local er = getRoot(p)
            local on = CFG.HitboxEnemy and myRoot and er and isEnemy(p)
                and (er.Position - myRoot.Position).Magnitude <= CFG.ScanRange
            setHB(c:FindFirstChild("HumanoidRootPart"), on, body, CFG.EnemyHitboxTransp)
            setHB(c:FindFirstChild("Head"), on, headS, nil) -- đầu giữ nguyên độ trong suốt
        end
    end
end)

-- Hitbox vũ khí: 4 lần/giây là đủ
do
    local hbTimer = 0
    bind(RunService.Heartbeat, function(dt)
        hbTimer += dt
        if hbTimer < 0.25 then return end
        hbTimer = 0
        if CFG.HitboxWeapon then
            local ws = Vector3.new(CFG.WeaponHitboxSize, CFG.WeaponHitboxSize, CFG.WeaponHitboxSize)
            local myChar = getChar(LP)
            for _, tool in ipairs(getTools()) do
                local on = myChar ~= nil and tool.Parent == myChar
                for _, d in ipairs(tool:GetDescendants()) do
                    if d:IsA("BasePart") and (d.Name == "Handle" or d.Name:lower():find("hitbox")) then
                        setHB(d, on, ws, CFG.WeaponHitboxTransp)
                    end
                end
            end
        else
            for part in pairs(hbOrig) do
                if part:FindFirstAncestorOfClass("Tool") then setHB(part, false) end
            end
        end
    end)
end

