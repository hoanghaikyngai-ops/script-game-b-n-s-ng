local function getSilentPart()
    if not CFG.SilentAim or not State.HasTool then return nil end
    local t = getSilentTarget()
    local c = getChar(t)
    return c and (c:FindFirstChild(CFG.AimPart) or c:FindFirstChild("HumanoidRootPart"))
end
env.__HHubSilent = CFG.SilentAim and getSilentPart or nil -- dùng cho hook Mouse.Hit/Target

local function originNearMe(origin)
    local r = CFG.SilentOriginRadius
    local cam = Workspace.CurrentCamera
    if cam and (cam.CFrame.Position - origin).Magnitude <= r then return true end
    local root = getRoot(LP)
    return root ~= nil and (root.Position - origin).Magnitude <= r
end

local function redirect(origin, dirLen, part)
    if dirLen < CFG.SilentMinRay then return nil end
    if not originNearMe(origin) then return nil end
    local v = part.Position - origin
    if v.Magnitude < 1e-3 then return nil end
    return v.Unit * math.max(dirLen, v.Magnitude + 5)
end

-- Bộ lọc "chỉ trúng nhân vật kẻ địch" -> tia đi xuyên mọi bức tường/vật cản
local function includeOnly(part)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Include
    rp.FilterDescendantsInstances = { part.Parent }
    return rp
end

-- Xử lý namecall (nằm trong script hiện tại để luôn đọc đúng CFG).
-- Trả về nil = không đụng; hoặc { args = {...}, n = số } = gọi lại với tham số mới;
-- hoặc { ret = {...}, n = số } = trả luôn kết quả này.
local function onNamecall(self, m, args, n)
    -- 1) remote bắn của game
    if CombatRemote and self == CombatRemote then
        if CFG.LogCombatRemote and (m == "FireServer" or m == "InvokeServer") then
            print("[H Hub][CombatLog] method = " .. m)
            for i = 1, n do print("[H Hub][CombatLog] arg" .. i .. " = " .. dump(args[i])) end
            print("[H Hub][CombatLog] ----")
        end
        if CFG.SilentRemote and m == "FireServer" then
            local part = getSilentPart()
            if part then
                local myRoot = getRoot(LP)
                local myChar = getChar(LP)
                local changed = false
                for i = 1, n do
                    local v = args[i]
                    local tv = typeof(v)
                    if tv == "Vector3" then
                        if myRoot and (v - myRoot.Position).Magnitude > 15 then
                            args[i] = part.Position changed = true
                        end
                    elseif tv == "Instance" then
                        if v:IsA("BasePart") and not (myChar and v:IsDescendantOf(myChar)) then
                            args[i] = part changed = true
                        elseif v:IsA("Player") and v ~= LP then
                            args[i] = Players:GetPlayerFromCharacter(part.Parent) or v changed = true
                        elseif v:IsA("Model") and v ~= myChar and v:FindFirstChildOfClass("Humanoid") then
                            args[i] = part.Parent changed = true
                        end
                    end
                end
                if changed then return { args = args, n = n } end
            end
        end
        return nil
    end

    if not CFG.SilentAim then return nil end

    -- 2) raycast của vũ khí
    if self == Workspace and (m == "Raycast" or m == "FindPartOnRayWithIgnoreList"
        or m == "FindPartOnRay" or m == "findPartOnRay" or m == "FindPartOnRayWithWhitelist") then
        local part = getSilentPart()
        if not part then return nil end
        if m == "Raycast" then
            local origin, dir = args[1], args[2]
            if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" then
                local nd = redirect(origin, dir.Magnitude, part)
                if nd then
                    args[2] = nd
                    args[3] = includeOnly(part) -- XUYÊN TƯỜNG: chỉ trúng nhân vật kẻ địch
                    return { args = args, n = math.max(n, 3) }
                end
            end
        elseif typeof(args[1]) == "Ray" then
            local r = args[1]
            local nd = redirect(r.Origin, r.Direction.Magnitude, part)
            if nd then
                -- trả luôn kết quả "trúng người": part, vị trí, pháp tuyến, vật liệu
                return { ret = { part, part.Position, Vector3.yAxis, part.Material }, n = 4 }
            end
        end
        return nil
    end

    -- 3) camera: tia từ màn hình (nút bắn trên điện thoại)
    if (m == "ScreenPointToRay" or m == "ViewportPointToRay") and self == Workspace.CurrentCamera then
        local part = getSilentPart()
        if part then
            local o = self.CFrame.Position
            local v = part.Position - o
            if v.Magnitude > 1e-3 then return { ret = { Ray.new(o, v.Unit) }, n = 1 } end
        end
    end
    return nil
end
env.__HHubNC = onNamecall

local silentHooked = false
-- Hook cài MỘT LẦN cho cả phiên; hook chỉ chuyển giao cho env.__HHubNC / env.__HHubSilent
-- (nên chạy lại script vẫn dùng đúng logic + cấu hình mới).
local function installSilentHooks()
    if silentHooked then return end
    if env.__HHubHooked2 then silentHooked = true return end
    if not (hookmetamethod and getnamecallmethod and checkcaller) then
        warn("[H Hub] Executor không hỗ trợ hookmetamethod/getnamecallmethod/checkcaller -> 'Đạn về mục tiêu' không hoạt động. Dùng 'Aim camera' thay thế.")
        return
    end
    local mouse = LP:GetMouse()
    local oldIndex, oldNamecall

    oldIndex = hookmetamethod(game, "__index", function(self, k)
        if self == mouse and (k == "Hit" or k == "Target") and not checkcaller() then
            local f = env.__HHubSilent
            local part = f and f()
            if part then return (k == "Hit") and part.CFrame or part end
        end
        return oldIndex(self, k)
    end)

    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local h = env.__HHubNC
        if h and not checkcaller() then
            local m = getnamecallmethod()
            local n = select("#", ...)
            local args = { ... }
            local ok, r = pcall(h, self, m, args, n)
            if ok and r then
                if r.ret then return unpack(r.ret, 1, r.n) end
                if r.args then return oldNamecall(self, unpack(r.args, 1, r.n)) end
            end
        end
        return oldNamecall(self, ...)
    end)
    env.__HHubHooked2 = true
    silentHooked = true
end
if CFG.SilentAim then installSilentHooks() end

