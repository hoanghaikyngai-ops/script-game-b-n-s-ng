-- Chỉ hoạt động khi: bật nút + đang cầm vũ khí. Tia raycast chỉ bị đổi hướng khi
-- xuất phát gần bạn và đủ dài (tia của vũ khí), các raycast khác của game giữ nguyên.
---------------------------------------------------------------------
local function getSilentPart()
    if not CFG.SilentAim or not State.HasTool then return nil end
    local t = getSilentTarget() -- kẻ địch gần nhất, độc lập với Aim camera / nút ĐỔI
    local c = getChar(t)
    return c and (c:FindFirstChild(CFG.AimPart) or c:FindFirstChild("HumanoidRootPart"))
end
env.__HHubSilent = CFG.SilentAim and getSilentPart or nil -- nil khi tắt -> hook thoát ngay, không tốn gì

local function originNearMe(origin)
    local r = CFG.SilentOriginRadius
    local cam = Workspace.CurrentCamera
    if cam and (cam.CFrame.Position - origin).Magnitude <= r then return true end
    local root = getRoot(LP)
    return root ~= nil and (root.Position - origin).Magnitude <= r
end

-- trả về hướng mới (độ dài đủ để chạm mục tiêu) hoặc nil nếu không nên đổi
local function redirect(origin, dirLen, part)
    if dirLen < CFG.SilentMinRay then return nil end
    if not originNearMe(origin) then return nil end
    local v = part.Position - origin
    if v.Magnitude < 1e-3 then return nil end
    return v.Unit * math.max(dirLen, v.Magnitude + 5)
end

local silentHooked = false
-- Chỉ cài hook khi bạn BẬT "Đạn về mục tiêu" lần đầu (hook chạy cho mọi lời gọi của game nên rất nặng).
local function installSilentHooks()
    if silentHooked then return end
    if env.__HHubHooked then silentHooked = true return end
    if not (hookmetamethod and getnamecallmethod and checkcaller) then
        warn("[H Hub] Executor không hỗ trợ hookmetamethod/getnamecallmethod/checkcaller -> 'Đạn về mục tiêu' không hoạt động. Dùng 'Aim camera' thay thế.")
        return
    end
    local mouse = LP:GetMouse()
    local oldIndex, oldNamecall

    oldIndex = hookmetamethod(game, "__index", function(self, k)
        if self == mouse and (k == "Hit" or k == "Target") and not checkcaller() then
            local f = env.__HHubSilent
            local part = f and f()
            if part then return (k == "Hit") and part.CFrame or part end
        end
        return oldIndex(self, k)
    end)

    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        if CFG.LogCombatRemote and CombatRemote and self == CombatRemote and not checkcaller() then
            local m = getnamecallmethod()
            if m == "FireServer" or m == "InvokeServer" then
                local args = { ... }
                print("[H Hub][CombatLog] method = " .. m)
                for i = 1, select("#", ...) do
                    print("[H Hub][CombatLog] arg" .. i .. " = " .. dump(args[i]))
                end
                print("[H Hub][CombatLog] ----")
            end
        end

        local f = env.__HHubSilent
        if f and (self == Workspace or self == Workspace.CurrentCamera) and not checkcaller() then
            local m = getnamecallmethod()
            if self == Workspace and (m == "Raycast" or m == "FindPartOnRayWithIgnoreList"
                or m == "FindPartOnRay" or m == "findPartOnRay") then
                local part = f()
                if part then
                    local args = { ... }
                    if m == "Raycast" then
                        local origin, dir = args[1], args[2]
                        if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" then
                            local nd = redirect(origin, dir.Magnitude, part)
                            if nd then
                                args[2] = nd
                                return oldNamecall(self, unpack(args))
                            end
                        end
                    elseif typeof(args[1]) == "Ray" then
                        local r = args[1]
                        local nd = redirect(r.Origin, r.Direction.Magnitude, part)
                        if nd then
                            args[1] = Ray.new(r.Origin, nd)
                            return oldNamecall(self, unpack(args))
                        end
                    end
                end
            elseif self == Workspace.CurrentCamera and (m == "ScreenPointToRay" or m == "ViewportPointToRay") then
                local part = f()
                if part then
                    local o = self.CFrame.Position
                    local v = part.Position - o
                    if v.Magnitude > 1e-3 then return Ray.new(o, v.Unit) end
                end
            end
        end
        return oldNamecall(self, ...)
    end)
    env.__HHubHooked = true
    silentHooked = true
end
if CFG.SilentAim then installSilentHooks() end

