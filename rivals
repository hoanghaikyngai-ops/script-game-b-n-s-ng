-- ESP (đỏ, xuyên tường)
---------------------------------------------------------------------
local espObjs = {}

local function clearESP(p)
    local o = espObjs[p]
    if o then
        for _, inst in pairs(o) do pcall(function() inst:Destroy() end) end
        espObjs[p] = nil
    end
end

local function updateESP(target)
    local myRoot = getRoot(LP)
    if not CFG.ESP then
        for p in pairs(espObjs) do clearESP(p) end
        return
    end

    -- chỉ vẽ ESP cho ESPMax kẻ địch gần nhất (Highlight rất nặng khi đông người)
    local allowed, cand = {}, {}
    if myRoot then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and isAlive(p) and not skip(p) and not isTeammate(p) then
                table.insert(cand, { p = p, d = (getRoot(p).Position - myRoot.Position).Magnitude })
            end
        end
        table.sort(cand, function(a, b) return a.d < b.d end)
        for i = 1, math.min(CFG.ESPMax, #cand) do allowed[cand[i].p] = true end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local char, root = getChar(p), getRoot(p)
            if allowed[p] and char and root then
                local o = espObjs[p]
                if not o or not o.hl.Parent or not o.bb.Parent or o.hl.Adornee ~= char then
                    clearESP(p)
                    local hl = Instance.new("Highlight")
                    hl.Name = "HHub_ESP"
                    hl.Adornee = char
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = char

                    local bb = Instance.new("BillboardGui")
                    bb.Name = "HHub_Tag"
                    bb.Adornee = root
                    bb.AlwaysOnTop = true
                    bb.Size = UDim2.new(0, 160, 0, 34)
                    bb.StudsOffset = Vector3.new(0, 3.5, 0)
                    bb.Parent = root
                    local tl = Instance.new("TextLabel")
                    tl.BackgroundTransparency = 1
                    tl.Size = UDim2.fromScale(1, 1)
                    tl.Font = Enum.Font.GothamBold
                    tl.TextSize = 14
                    tl.TextColor3 = Color3.fromRGB(255, 60, 60)
                    tl.TextStrokeTransparency = 0
                    tl.Parent = bb
                    o = { hl = hl, bb = bb, tl = tl }
                    espObjs[p] = o
                end
                local isTarget = (p == target) or (CFG.SilentAim and p == silentTarget)
                o.hl.FillTransparency = isTarget and 0.15 or 0.55
                local dist = myRoot and math.floor((root.Position - myRoot.Position).Magnitude) or 0
                local txt = (isTarget and "🎯 " or "") .. p.DisplayName .. " [" .. dist .. "]"
                if o.tl.Text ~= txt then o.tl.Text = txt end
            else
                clearESP(p)
            end
        end
    end
end

bind(Players.PlayerRemoving, function(p)
    clearESP(p)
    if State.LockedTarget == p then State.LockedTarget = nil nextTargetScan = 0 end
    if cachedTarget == p then cachedTarget = nil nextTargetScan = 0 end
end)

-- Ép ngưng + quét lại từ đầu NGAY khi mục tiêu tạch (chết), không chờ tới chu kỳ quét 0.12s.
local function forceResetIfTarget(p)
    deadUntil[p] = os.clock() + CFG.RespawnIgnore -- bỏ qua người này một lúc, kể cả khi họ hồi sinh ngay
    if silentTarget == p then silentTarget = nil end
    silentNext = 0
    if State.LockedTarget == p then
        State.LockedTarget = nil
        nextTargetScan = 0
    end
    if cachedTarget == p then
        cachedTarget = nil   -- xóa tên/khóa mục tiêu cũ
        nextTargetScan = 0   -- ép quét lại từ đầu ngay frame kế tiếp
    end
    clearESP(p) -- xóa luôn ESP/tên hiển thị của người vừa tạch
end

local trackedHum = setmetatable({}, { __mode = "k" })
-- Bắt cả Died lẫn HealthChanged (một số game không bắn Died đúng lúc)
local function watchHum(p, hum)
    trackedHum[hum] = {
        hum.Died:Connect(function() forceResetIfTarget(p) end),
        hum.HealthChanged:Connect(function(h) if h <= 0 then forceResetIfTarget(p) end end),
    }
end
