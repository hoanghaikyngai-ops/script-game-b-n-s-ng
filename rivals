-- SILENT AIM: bắn đi đâu cũng được, đạn luôn bay về người bị nhắm
-- Hook gọi qua env (__HHubSilent / __HHubRedirect / __HHubLog) để luôn dùng cấu hình của lần chạy MỚI NHẤT
---------------------------------------------------------------------
local function getSilentPart()
    if not CFG.SilentAim or not State.HasTool then return nil end
    local t = State.SelectedTarget
    if t and not isEnemy(t) then return nil end -- xác thì không kéo đạn về
    return t and getAimPart(t)
end
env.__HHubSilent = getSilentPart

local function originNearMe(origin)
    local r = CFG.SilentOriginRadius
    local cam = Workspace.CurrentCamera
    if cam and (cam.CFrame.Position - origin).Magnitude <= r then return true end
    local root = getRoot(LP)
    return root ~= nil and (root.Position - origin).Magnitude <= r
end

local function redirect(origin, dirLen, part)
    if dirLen < CFG.SilentMinRay then return nil end
    if not originNearMe(origin) then return nil end
    local v = getLeadPos(part, origin) - origin
    if v.Magnitude < 1e-3 then return nil end
    return v.Unit * math.max(dirLen, v.Magnitude + 5)
end
env.__HHubRedirect = redirect

env.__HHubLog = function(self, ...)
    if not (CFG.LogCombatRemote and CombatRemote and self == CombatRemote) then return end
    if checkcaller() then return end
    local m = getnamecallmethod()
    if m == "FireServer" or m == "InvokeServer" then
        local args = { ... }
        print("[H Hub][CombatLog] method = " .. m)
        for i = 1, select("#", ...) do print("[H Hub][CombatLog] arg" .. i .. " = " .. dump(args[i])) end
        print("[H Hub][CombatLog] ----")
    end
end

local silentHooked = false
if hookmetamethod and getnamecallmethod and checkcaller and not env.__HHubHooked then
    local mouse = LP:GetMouse()
    local oldIndex, oldNamecall
    local wrap = function(f) return f end -- không bọc newcclosure (một số executor làm hook camera hỏng)

    oldIndex = hookmetamethod(game, "__index", wrap(function(self, k)
        if self == mouse and (k == "Hit" or k == "Target") and not checkcaller() then
            local f = env.__HHubSilent
            local part = f and f()
            if part then return (k == "Hit") and part.CFrame or part end
        end
        return oldIndex(self, k)
    end))

    oldNamecall = hookmetamethod(game, "__namecall", wrap(function(self, ...)
        local lg = env.__HHubLog
        if lg then lg(self, ...) end

        local f = env.__HHubSilent
        local rd = env.__HHubRedirect
        if f and rd and (self == Workspace or self == Workspace.CurrentCamera) and not checkcaller() then
            local m = getnamecallmethod()
            if self == Workspace and (m == "Raycast" or m == "FindPartOnRayWithIgnoreList"
                or m == "FindPartOnRay" or m == "findPartOnRay") then
                local part = f()
                if part then
                    local args = { ... }
                    if m == "Raycast" then
                        local origin, dir = args[1], args[2]
                        if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" then
                            local nd = rd(origin, dir.Magnitude, part)
                            if nd then args[2] = nd return oldNamecall(self, unpack(args)) end
                        end
                    elseif typeof(args[1]) == "Ray" then
                        local r = args[1]
                        local nd = rd(r.Origin, r.Direction.Magnitude, part)
                        if nd then args[1] = Ray.new(r.Origin, nd) return oldNamecall(self, unpack(args)) end
                    end
                end
            elseif self == Workspace.CurrentCamera and (m == "ScreenPointToRay" or m == "ViewportPointToRay") then
                local part = f()
                if part then
                    local o = self.CFrame.Position
                    local v = part.Position - o
                    if v.Magnitude > 1e-3 then return Ray.new(o, v.Unit) end
                end
            end
        end
        return oldNamecall(self, ...)
    end))
    env.__HHubHooked = true
    silentHooked = true
elseif env.__HHubHooked then
    silentHooked = true
end

