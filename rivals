local function refreshLock()
    if State.LockedTarget then
        lockBtn.Text = "🔒 NHẢ KHÓA"
        lockBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    else
        lockBtn.Text = "🔓 KHÓA"
