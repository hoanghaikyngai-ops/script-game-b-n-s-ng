-- VÒNG LẶP CHÍNH
---------------------------------------------------------------------
local origWalk, origJump
local switchIdx, switchTimer, shootTimer = 0, 0, 0
local menuVisible = true
local statusLabel

bind(RunService.Heartbeat, function(dt)
    local root, hum = getRoot(LP), getHum(LP)
    if not root or not hum or hum.Health <= 0 then stopFly() return end

    if CFG.Speed then
        origWalk = origWalk or hum.WalkSpeed
        hum.WalkSpeed = CFG.WalkSpeed
    elseif origWalk then
        hum.WalkSpeed = origWalk origWalk = nil
    end
    if CFG.HighJump then
        origJump = origJump or { hum.UseJumpPower, hum.JumpPower }
        hum.UseJumpPower = true
        hum.JumpPower = CFG.JumpPower
    elseif origJump then
        hum.UseJumpPower, hum.JumpPower = origJump[1], origJump[2] origJump = nil
    end

    local target = getTarget()
    updateESP(target)

    -- tự đuổi + bay lên đầu mục tiêu (trong tầm quét)
    local chasing = false
    if CFG.Chase and target then
        local tRoot = getRoot(target)
        if tRoot and (tRoot.Position - root.Position).Magnitude <= CFG.ScanRange then
            chasing = true
            stopFly()
            local goal = tRoot.Position + Vector3.new(0, CFG.ChaseHeight, 0)
            local delta = goal - root.Position
            local dist = delta.Magnitude
            local step = CFG.ChaseSpeed * dt
            local newPos = (dist <= step) and goal or (root.Position + delta.Unit * step)
            root.CFrame = CFrame.new(newPos) * (root.CFrame - root.CFrame.Position)
            root.AssemblyLinearVelocity = Vector3.zero
        end
    end

    if not chasing then
        if CFG.Fly then doFly(root, hum) else stopFly() end
    end

    -- tự bắn
    if CFG.AutoShoot and target then
        shootTimer += dt
        local tRoot = getRoot(target)
        if shootTimer >= 0.06 and tRoot and (tRoot.Position - root.Position).Magnitude <= CFG.ShootRange then
            shootTimer = 0
            local tool = getChar(LP):FindFirstChildOfClass("Tool")
            if tool then
                pcall(function() tool:Activate() end)
                if mouse1click and not menuVisible then pcall(mouse1click) end
            end
        end
    end

    -- tự đổi súng
    if CFG.AutoSwitch then
        switchTimer += dt
        if switchTimer >= CFG.SwitchDelay then
            switchTimer = 0
            local tools = getTools()
            if #tools > 0 then
                switchIdx = switchIdx % #tools + 1
                pcall(function() hum:EquipTool(tools[switchIdx]) end)
            end
        end
    end

    if statusLabel then
        if target then
            local tr = getRoot(target)
            local d = tr and math.floor((tr.Position - root.Position).Magnitude) or 0
            statusLabel.Text = (State.LockedTarget and "🔒 " or "👁 ") .. target.DisplayName .. " [" .. d .. "]" .. (chasing and " ✈" or "")
        else
            statusLabel.Text = "Không có mục tiêu"
        end
    end
end)

RunService:BindToRenderStep("HHub_Aim", Enum.RenderPriority.Camera.Value + 1, function()
    if not CFG.AimLock then return end
    local target = getTarget()
    local c = getChar(target)
    local part = c and (c:FindFirstChild(CFG.AimPart) or c:FindFirstChild("HumanoidRootPart"))
    if part then
        local want = CFrame.lookAt(Camera.CFrame.Position, part.Position)
        Camera.CFrame = (CFG.AimSmooth >= 1) and want or Camera.CFrame:Lerp(want, CFG.AimSmooth)
    end
end)

bind(UIS.JumpRequest, function()
    if CFG.InfJump then
        local h = getHum(LP)
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

