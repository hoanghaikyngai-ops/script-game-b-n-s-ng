-- NÉ: (1) tự né đạn vật lý  (2) né khi tâm súng địch chĩa vào mình
-- Dùng chung 1 hồi chiêu để không dịch chuyển hai lần cùng lúc.
-- Dịch chuyển nhiều có thể bị anti-cheat của game phát hiện.
---------------------------------------------------------------------
do
    local proj = {}   -- [Part] = hạn theo dõi
    local nProj = 0
    local cd = 0
    local flip = 1

    local function track(o)
        if nProj > 200 then return end
        if not o:IsA("BasePart") or o.Anchored then return end
        if o.Size.Magnitude > 6 then return end                      -- bỏ vật to
        local m = o:FindFirstAncestorOfClass("Model")
        if m and m:FindFirstChildOfClass("Humanoid") then return end -- bỏ nhân vật
        if o:FindFirstAncestorOfClass("Tool") then return end
        if not proj[o] then nProj += 1 end
        proj[o] = tick() + 3
    end

    bind(Workspace.DescendantAdded, function(o)
        if CFG.AutoDodge then task.defer(track, o) end
    end)

    local function dodgeProjectile(root, now)
        for part, expire in pairs(proj) do
            if not part.Parent or now > expire then
                proj[part] = nil
                nProj -= 1
            else
                local v = part.AssemblyLinearVelocity
                local speed = v.Magnitude
                if speed >= CFG.DodgeMinSpeed then
                    local rel = root.Position - part.Position
                    local t = rel:Dot(v) / (speed * speed) -- thời điểm gần nhất
                    if t > 0 and t < CFG.DodgeTime then
                        local closest = part.Position + v * t
                        local off = root.Position - closest
                        if off.Magnitude < CFG.DodgeRadius then
                            local side = Vector3.new(off.X, 0, off.Z)
                            if side.Magnitude < 0.5 then
                                local pp = v:Cross(Vector3.yAxis)
                                side = (pp.Magnitude > 0.01) and pp.Unit or Vector3.xAxis
                                if math.random() < 0.5 then side = -side end
                            end
                            root.CFrame = root.CFrame + side.Unit * CFG.DodgeDistance
                            cd = 0.12
                            proj[part] = nil
                            nProj -= 1
                            return true
                        end
                    end
                end
            end
        end
        return false
    end

    local function dodgeAim(root)
        for _, p in ipairs(getAllTargets()) do
            if isEnemy(p) then
                local c = getChar(p)
                local head = c and c:FindFirstChild("Head")
                if head then
                    local to = root.Position - head.Position
                    local dist = to.Magnitude
                    if dist > 3 and dist <= CFG.DodgeAimRange then
                        local look = head.CFrame.LookVector
                        local ang = math.acos(math.clamp(look:Dot(to.Unit), -1, 1))
                        if ang <= math.atan(CFG.DodgeAimRadius / dist) then
                            local side = look:Cross(Vector3.yAxis)
                            side = Vector3.new(side.X, 0, side.Z)
                            if side.Magnitude < 0.01 then side = Vector3.xAxis end
                            if math.random() < 0.3 then flip = -flip end -- đổi hướng ngẫu nhiên cho khó đoán
                            root.CFrame = root.CFrame + side.Unit * flip * CFG.DodgeAimDistance
                            cd = CFG.DodgeAimCooldown
                            return true
                        end
                    end
                end
            end
        end
        return false
    end

    bind(RunService.Heartbeat, function(dt)
        if not CFG.AutoDodge then
            if nProj > 0 then proj, nProj = {}, 0 end
        end
        if not (CFG.AutoDodge or CFG.DodgeAim) then return end
        cd -= dt
        if cd > 0 or CFG.Chase then return end -- đang đuổi/tele thì không né (tránh đánh nhau với lệnh tele)
        local root, hum = getRoot(LP), getHum(LP)
        if not root or not hum or hum.Health <= 0 then return end
        if CFG.AutoDodge and dodgeProjectile(root, tick()) then return end
        if CFG.DodgeAim then dodgeAim(root) end
    end)
end

