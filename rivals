local function makeVirtualButton(text, startPos)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 64, 0, 64)
    b.Position = startPos
    b.BackgroundColor3 = BG2
    b.BackgroundTransparency = 0.35
    b.BorderSizePixel = 0
    b.Text = text
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.TextColor3 = Color3.new(1, 1, 1)
    b.AutoButtonColor = false
    b.Parent = gui
    corner(b, 32)
    table.insert(shimmerStrokes, stroke(b, 2))

    local entry = { frame = b, locked = false, hidden = false }
    makeDraggable(b, b, function() return entry.locked end)
    return entry
end

