-- HOOK CAMERA: game tự viết camera góc nhìn thứ nhất và ghi đè mỗi khung.
-- Thay vì đua với game, ta chặn đúng lệnh "Camera.CFrame = ..." của game
-- rồi giữ vị trí game đặt, chỉ xoay hướng nhìn về mục tiêu.
---------------------------------------------------------------------
local function camFix(cf)
    if not (CFG.CamHook and CFG.AimLock) or CFG.AimMouse then return nil end
    local target = State.SelectedTarget
    if target and not isEnemy(target) then State.SelectedTarget = nil return nil end -- xác thì không bám
    local part = target and getAimPart(target)
    if not part then return nil end
    local pos = cf.Position
    local want = safeLookAt(pos, getLeadPos(part, pos))
    if CFG.AimSpeed >= 100 then return want end
    return cf:Lerp(want, CFG.AimSpeed / 100)
end
env.__HHubCamFix = camFix

local camHookOk = false
if hookmetamethod and checkcaller and not env.__HHubNewIndexHooked then
    local okHook = pcall(function()
        local wrap = function(f) return f end -- không bọc newcclosure (một số executor làm hook camera hỏng)
        local oldNewIndex
        oldNewIndex = hookmetamethod(game, "__newindex", wrap(function(self, k, v)
            if k == "CFrame" and typeof(v) == "CFrame" then
                local f = env.__HHubCamFix
                if f and self == Workspace.CurrentCamera and not checkcaller() then
                    local nv = f(v)
                    if nv then
                        env.__HHubHookTick = tick() -- báo cho vòng aim biết hook đang hoạt động
                        return oldNewIndex(self, k, nv)
                    end
                end
            end
            return oldNewIndex(self, k, v)
        end))
    end)
    if okHook then env.__HHubNewIndexHooked = true end
    camHookOk = okHook
elseif env.__HHubNewIndexHooked then
    camHookOk = true
end
env.__HHubCamHookOk = camHookOk
if not camHookOk then
    warn("[H Hub] Executor không hook được __newindex -> 'Hook camera' không hoạt động. Thử 'Aim bằng chuột (ép)'.")
end

