do
    local shimmerTimer = 0
    bind(RunService.Heartbeat, function(dt)
        shimmerTimer += dt
        if shimmerTimer < 0.05 then return end
        shimmerTimer = 0
        local t = (math.sin(tick() * 2.2) + 1) / 2
        local c = NAVY_DIM:Lerp(NAVY_BRIGHT, t)
        for _, s in ipairs(shimmerStrokes) do s.Color = c end
        for _, tl in ipairs(shimmerTexts) do tl.TextColor3 = c end
        for _, f in ipairs(shimmerFills) do f.BackgroundColor3 = c end
        for _, tb in ipairs(toggleBtns) do
            if CFG[tb.key] then
                tb.btn.BackgroundColor3 = NAVY_DIM:Lerp(NAVY_BRIGHT, t * 0.7 + 0.2)
            else
                tb.btn.BackgroundColor3 = OFFC
            end
        end
        local want = State.LockedTarget ~= nil
        if (lockBtn.Text:find("NHẢ") ~= nil) ~= want then refreshLock() end
    end)
end

