bind(UIS.InputBegan, function(input, gp)
    if rebinding and input.UserInputType == Enum.UserInputType.Keyboard then
        rebinding = false
        if input.KeyCode ~= Enum.KeyCode.Escape then CFG.LockKey = input.KeyCode end
        refreshLock()
        return
    end
    if gp then return end
    if input.KeyCode == CFG.LockKey then
        toggleLock()
    elseif input.KeyCode == CFG.ChangeKey then
        changeTarget()
    elseif input.KeyCode == CFG.SwitchKey then
        switchWeaponNow()
    elseif input.KeyCode == CFG.ShootKey then
        CFG.AutoShoot = not CFG.AutoShoot -- Z: bật/tắt tự bắn (nút "Tự bắn" trong bảng đổi màu theo)
        saveConfig()
    elseif input.KeyCode == CFG.MenuKey then
        toggleMenu()
    end
end)

