-- Nếu thả nút đè lên bảng aim thì tự đẩy ra phía trên (hoặc dưới) bảng đó để không bị kẹt
local function unstickShowHide()
    if not showHideBtn.Parent or not lockFrame.Visible then return end
    local a, asz = showHideBtn.AbsolutePosition, showHideBtn.AbsoluteSize
    local p, psz = lockFrame.AbsolutePosition, lockFrame.AbsoluteSize
    local overlap = a.X < p.X + psz.X and a.X + asz.X > p.X
        and a.Y < p.Y + psz.Y and a.Y + asz.Y > p.Y
    if overlap then
        local newY = p.Y - asz.Y - 10
        if newY < 0 then newY = p.Y + psz.Y + 10 end
        showHideBtn.Position = UDim2.fromOffset(a.X, newY)
    end
end
bind(UIS.InputEnded, function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        task.defer(unstickShowHide)
    end
end)

bind(UIS.InputBegan, function(input, gp)
    if rebinding and input.UserInputType == Enum.UserInputType.Keyboard then
        rebinding = false
        if input.KeyCode ~= Enum.KeyCode.Escape then CFG.LockKey = input.KeyCode end
        refreshLock()
        return
    end
    if gp then return end
    if input.KeyCode == CFG.LockKey then
        toggleLock()
    elseif input.KeyCode == CFG.FreeCamKey then
        toggleCam()
    elseif input.KeyCode == CFG.MenuKey then
        toggleMenu()
    end
end)

refreshLock()

