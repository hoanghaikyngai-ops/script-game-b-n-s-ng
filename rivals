local function forceResetIfTarget(p)
    markDead(p) -- vừa chết/rời -> bỏ qua ngay lập tức
    if State.LockedTarget == p then
        State.LockedTarget = nil
        if CFG.SwitchOnDeath then relockUntil = tick() + 3 end -- khóa tiếp sang người kế
    end
    if State.SelectedTarget == p then State.SelectedTarget = nil end
    if autoTarget == p then autoTarget = nil end
end
onEntityDied = forceResetIfTarget

local trackedHum = setmetatable({}, { __mode = "k" })
local trackedPlayers = setmetatable({}, { __mode = "k" })

local function hookHum(p, char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and not trackedHum[hum] then
        trackedHum[hum] = true
        -- bind() để kết nối được dọn khi chạy lại script
        bind(hum.Died, function() forceResetIfTarget(p) end)
        -- máu về ngưỡng chết => đổi mục tiêu ngay (kể cả khi game không bắn sự kiện Died)
        bind(hum.HealthChanged, function(h)
            local m = hum.MaxHealth
            local pct = (m and m > 0) and (h / m * 100) or h
            if pct <= CFG.DeadThresholdPct then forceResetIfTarget(p) end
        end)
    end
end

-- gọi lặp lại cũng an toàn: chỉ nối sự kiện 1 lần cho mỗi người, còn nhân vật hiện tại luôn được kiểm tra lại
local function trackPlayerDeath(p)
    if not trackedPlayers[p] then
        trackedPlayers[p] = true
        bind(p.CharacterAdded, function(char)
            task.defer(function()
                char:WaitForChild("Humanoid", 5)
                hookHum(p, char)
            end)
        end)
    end
    hookHum(p, getChar(p))
end

for _, p in ipairs(Players:GetPlayers()) do if p ~= LP then trackPlayerDeath(p) end end
bind(Players.PlayerAdded, function(p) if p ~= LP then trackPlayerDeath(p) end end)
