-- ESP KHUNG 2D: chạy RenderStepped để khung bám kịp người chạy/nhảy
---------------------------------------------------------------------
local espFrames = {}

local function clearESPFrame(p)
    local o = espFrames[p]
    if o then
        pcall(function() o.hl:Destroy() end)
        pcall(function() o.box:Destroy() end)
        pcall(function() o.tag:Destroy() end)
        espFrames[p] = nil
    end
end

local function ensureESPFrame(p)
    local o = espFrames[p]
    local char = getChar(p)
    if o and o.hl.Adornee == char then return o end
    if o then clearESPFrame(p) end

    local hl = Instance.new("Highlight")
    hl.Name = "HHub_ESP"
    hl.Adornee = char
    hl.FillColor = Color3.fromRGB(255, 0, 0)
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = char

    local box = Instance.new("Frame")
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.ZIndex = 5
    box.Parent = gui
    local bstroke = Instance.new("UIStroke")
    bstroke.Thickness = 2
    bstroke.Color = Color3.fromRGB(255, 0, 0)
    bstroke.Parent = box

    local tag = Instance.new("TextLabel")
    tag.BackgroundTransparency = 1
    tag.Size = UDim2.new(1, 40, 0, 16)
    tag.Position = UDim2.new(0, -20, 0, -18)
    tag.Font = Enum.Font.GothamBold
    tag.TextSize = 12
    tag.TextColor3 = Color3.fromRGB(255, 70, 70)
    tag.TextStrokeTransparency = 0
    tag.ZIndex = 5
    tag.Parent = box

    o = { hl = hl, box = box, stroke = bstroke, tag = tag }
    espFrames[p] = o
    return o
end

bind(RunService.RenderStepped, function()
    if not CFG.ESP then
        for p in pairs(espFrames) do clearESPFrame(p) end
        return
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            if isEnemy(p) then
                local o = ensureESPFrame(p)
                local espColor = getPlayerESPColor(p)
                o.hl.FillColor = espColor
                o.stroke.Color = espColor
                o.tag.TextColor3 = espColor
                local isTarget = (p == State.SelectedTarget)
                o.hl.FillTransparency = isTarget and 0.1 or 0.5

                local b = get2DBox(p)
                if b then
                    o.box.Visible = true
                    o.box.Position = UDim2.fromOffset(b.pos.X, b.pos.Y)
                    o.box.Size = UDim2.fromOffset(b.size.X, b.size.Y)
                    o.stroke.Thickness = isTarget and 3 or 1.5
                    o.stroke.Transparency = isTarget and 0 or 0.25
                    o.tag.Text = (isTarget and "🎯 " or "") .. p.DisplayName .. " [" .. math.floor(b.dist) .. "]"
                    o.tag.TextColor3 = Color3.fromRGB(255, isTarget and 60 or 110, isTarget and 60 or 110)
                else
                    o.box.Visible = false
                end
            else
                clearESPFrame(p)
            end
        end
    end
end)

bind(Players.PlayerRemoving, clearESPFrame)

