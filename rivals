-- GOD MODE (phía client)
-- Khóa máu ngay trong sự kiện HealthChanged, tắt state Dead, chạy cả khi máu đã về 0.
-- LƯU Ý: nếu game tính sát thương ở SERVER (phổ biến) thì server vẫn trừ máu thật của bạn.
---------------------------------------------------------------------
local godHooked = setmetatable({}, { __mode = "k" })
local godWasOn = false

local function godStep(hum)
    if CFG.GodMode then
        godWasOn = true
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            if hum.MaxHealth < CFG.GodHealth then hum.MaxHealth = CFG.GodHealth end
            if hum.Health ~= CFG.GodHealth then hum.Health = CFG.GodHealth end
        end)
        if not godHooked[hum] then
            godHooked[hum] = true
            table.insert(conns, hum.HealthChanged:Connect(function(h)
                if CFG.GodMode and h < CFG.GodHealth and hum.Parent then
                    pcall(function()
                        if hum.MaxHealth < CFG.GodHealth then hum.MaxHealth = CFG.GodHealth end
                        hum.Health = CFG.GodHealth
                    end)
                end
            end))
        end
    elseif godWasOn then
        godWasOn = false
        pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true) end)
    end
end

