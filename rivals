local conns = {}
local function bind(signal, fn)
    local c = signal:Connect(fn)
    table.insert(conns, c)
    return c
end

local function isPlayerEntity(p)
    return typeof(p) == "Instance" and p:IsA("Player")
end
local function getDisplayName(p)
    return isPlayerEntity(p) and p.DisplayName or p.Name
end
local function getChar(p)
    if p == nil then return nil end
    if isPlayerEntity(p) then
        local c = p.Character
        if c and c.Parent then return c end
        -- dự phòng: có game để nhân vật trong Workspace trước khi gán Player.Character
        local w = Workspace:FindFirstChild(p.Name)
        if w and w:IsA("Model") and w:FindFirstChildOfClass("Humanoid") then return w end
        return c
    end
    return p.Parent and p or nil -- NPC: bản thân Model chính là "character"
end
local function getRoot(p)
    local c = getChar(p)
    return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso")
        or c:FindFirstChild("Torso") or c.PrimaryPart)
end
local function getAimPart(p)
    local c = getChar(p)
    if not c then return nil end
    return c:FindFirstChild("Head") or getRoot(p) or c:FindFirstChildWhichIsA("BasePart")
end
local function getHum(p) local c = getChar(p) return c and c:FindFirstChildOfClass("Humanoid") end

