-- LockedTarget: mục tiêu đang bị khóa khi bật Aim camera
-- CamFree: true = tạm mở khóa camera (xoay tự do), mục tiêu vẫn được giữ
local State = { LockedTarget = nil, HasTool = false, CamFree = false }

-- Remote bắn của game (nếu có), lấy một lần khi script chạy
local CombatRemote = nil
do
    local ok, ev = pcall(function()
        return game:GetService("ReplicatedStorage").Remote.Event.Game["[C-S]SyncCombatAction"]
    end)
    if ok then CombatRemote = ev end
    if not CombatRemote then
        warn("[H Hub] Không tìm thấy remote [C-S]SyncCombatAction -> 'Dùng remote bắn' sẽ không hoạt động.")
    end
end

