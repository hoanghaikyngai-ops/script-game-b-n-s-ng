-- QUÉT LẠI KẺ ĐỊCH khi máu của mình về 0 / hồi sinh
---------------------------------------------------------------------
local lastRescan = 0
local function rescanEnemies()
    if tick() - lastRescan < 0.5 then return end
    lastRescan = tick()
    State.LockedTarget, State.SelectedTarget, autoTarget = nil, nil, nil
    relockUntil = 0
    for p in pairs(espFrames) do clearESPFrame(p) end
    restoreAllHB()                                   -- hitbox áp lại từ đầu ở khung kế tiếp
    for k in pairs(sideCache) do sideCache[k] = nil end -- đọc lại màu tên / team từ đầu
    for k in pairs(teamCache) do teamCache[k] = nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then trackPlayerDeath(p) end      -- đảm bảo người mới vào cũng được theo dõi
    end
    refreshLock()
end

local function watchSelf(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    table.insert(conns, hum.Died:Connect(rescanEnemies))
    table.insert(conns, hum.HealthChanged:Connect(function(h)
        if h <= 0 then rescanEnemies() end
    end))
end

bind(LP.CharacterAdded, function(char)
    task.spawn(watchSelf, char)
    task.delay(1.5, rescanEnemies) -- quét lại lần nữa sau khi hồi sinh
end)
if LP.Character then task.spawn(watchSelf, LP.Character) end

