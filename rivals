local function get2DBox(p)
    Camera = Workspace.CurrentCamera or Camera

    if not Camera or not p or p == LP then
        return nil
    end

    local char = p.Character
    if not char or not char:IsDescendantOf(Workspace) then
        return nil
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = getRoot(p)

    if not hum or hum.Health <= 0 or not root then
        return nil
    end

    local ok, boxCF, boxSize = pcall(function()
        return char:GetBoundingBox()
    end)

    if not ok or not boxCF or not boxSize then
        return nil
    end

    local half = boxSize * 0.5
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge

    local corners = {
        Vector3.new(-half.X, -half.Y, -half.Z),
        Vector3.new(-half.X, -half.Y, half.Z),
        Vector3.new(-half.X, half.Y, -half.Z),
        Vector3.new(-half.X, half.Y, half.Z),
        Vector3.new(half.X, -half.Y, -half.Z),
        Vector3.new(half.X, -half.Y, half.Z),
        Vector3.new(half.X, half.Y, -half.Z),
        Vector3.new(half.X, half.Y, half.Z)
    }

    -- Không dùng tọa độ giả khi mục tiêu ở sau camera.
    for _, corner in ipairs(corners) do
        local worldPos = boxCF:PointToWorldSpace(corner)
        local screenPos = Camera:WorldToViewportPoint(worldPos)

        if screenPos.Z <= 0 then
            return nil
        end

        minX = math.min(minX, screenPos.X)
        minY = math.min(minY, screenPos.Y)
        maxX = math.max(maxX, screenPos.X)
        maxY = math.max(maxY, screenPos.Y)
    end

    local vp = Camera.ViewportSize

    -- Không hiển thị khung nếu nhân vật hoàn toàn ngoài màn hình.
    if maxX < 0 or maxY < 0 or minX > vp.X or minY > vp.Y then
        return nil
    end

    -- Cắt khung theo màn hình.
    minX = math.clamp(minX, 0, vp.X)
    minY = math.clamp(minY, 0, vp.Y)
    maxX = math.clamp(maxX, 0, vp.X)
    maxY = math.clamp(maxY, 0, vp.Y)

    local width = maxX - minX
    local height = maxY - minY

    if width < 2 or height < 2 then
        return nil
    end

    return {
        pos = Vector2.new(minX, minY),
        size = Vector2.new(width, height),
        center = Vector2.new(
            (minX + maxX) / 2,
            (minY + maxY) / 2
        ),
        aimPoint = root.Position + Vector3.new(0, 1.5, 0),
        dist = (root.Position - Camera.CFrame.Position).Magnitude
    }
end
-- Mục tiêu tự động đang bám (khác với khóa tay State.LockedTarget) + ngưỡng chống nhảy qua lại
local autoTarget = nil
local SWITCH_MARGIN = 0.8 -- mục tiêu đang bám được ưu tiên thêm 20% để khỏi nhảy qua lại

local function pickScreenTarget()
    if State.LockedTarget and isEnemy(State.LockedTarget) then
        return State.LockedTarget, get2DBox(State.LockedTarget)
    end
    State.LockedTarget = nil

    Camera = Workspace.CurrentCamera or Camera
    if not Camera then return nil end
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local camPos = Camera.CFrame.Position

    local best, bestScore = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if isEnemy(p) then
            local part = getAimPart(p)
            if part then
                local dist = (part.Position - camPos).Magnitude
                if dist <= CFG.ScanRange then
                    local v = Camera:WorldToViewportPoint(part.Position)
                    local inFov = v.Z > 0 and (Vector2.new(v.X, v.Y) - center).Magnitude <= CFG.FOVRadius
                    if inFov or CFG.AimAnywhere then
                        -- ưu tiên người trong FOV, rồi tới gần nhất
                        local score = dist + (inFov and 0 or 10000)
                        if p == autoTarget then score = score * SWITCH_MARGIN end
                        if score < bestScore then best, bestScore = p, score end
                    end
                end
            end
        end
    end
    autoTarget = best
    return best, best and get2DBox(best)
end

