bind(RunService.Heartbeat, function()
    local h = (tick() * 0.2) % 1
    local c = Color3.fromHSV(h, 0.85, 1)
    for _, s in ipairs(rbStrokes) do s.Color = c end
    for _, t in ipairs(rbTexts) do t.TextColor3 = c end
    for i, f in ipairs(rbFills) do f.BackgroundColor3 = Color3.fromHSV((h + i * 0.07) % 1, 0.8, 1) end
    for _, t in ipairs(toggleBtns) do
        if CFG[t.key] then
            t.btn.BackgroundColor3 = Color3.fromHSV((h + t.idx * 0.06) % 1, 0.75, 0.85)
        else
            t.btn.BackgroundColor3 = OFFC
        end
    end
    local want = State.LockedTarget ~= nil
    if (lockBtn.Text:find("NHẢ") ~= nil) ~= want then refreshLock() end
end)

-- phím nóng
bind(UIS.InputBegan, function(input, gp)
    if rebinding and input.UserInputType == Enum.UserInputType.Keyboard then
        rebinding = false
        if input.KeyCode ~= Enum.KeyCode.Escape then CFG.LockKey = input.KeyCode end
        refreshLock()
        return
    end
    if gp then return end
    if input.KeyCode == CFG.LockKey then
        toggleLock()
    elseif input.KeyCode == CFG.MenuKey then
        menuVisible = not menuVisible
        main.Visible = menuVisible
        lockFrame.Visible = menuVisible
    end
end)

