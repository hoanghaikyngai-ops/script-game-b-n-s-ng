local hbOrig = setmetatable({}, { __mode = "k" })

local function setHB(part, on, size, transp)
    if not part or not part:IsA("BasePart") then return end
    if on then
        if not hbOrig[part] then
            hbOrig[part] = { Size = part.Size, Transparency = part.Transparency, CanCollide = part.CanCollide,
                Massless = part.Massless, CanQuery = part.CanQuery, CanTouch = part.CanTouch }
        end
        if part.Size ~= size then part.Size = size end -- game reset thì tự phóng lại
        if transp then part.Transparency = transp end
        part.CanCollide = false
        part.Massless = true
        part.CanQuery = true
        part.CanTouch = true
    else
        local o = hbOrig[part]
        if o then
            part.Size, part.Transparency, part.CanCollide = o.Size, o.Transparency, o.CanCollide
            part.Massless, part.CanQuery, part.CanTouch = o.Massless, o.CanQuery, o.CanTouch
            hbOrig[part] = nil
        end
    end
end

local function restoreAllHB()
    for part in pairs(hbOrig) do pcall(setHB, part, false) end
end

