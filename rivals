    AimSpeed = 100,   -- 100 = khóa cứng tức thì; nhỏ hơn = lia mượt/chậm hơn
    ESPMax = 20,      -- chỉ vẽ ESP cho bấy nhiêu kẻ địch gần nhất
    FixLag = true, MapWhite = true,
    TeleGround     = false,
    BehindDistance = 4,
    GroundDepth    = 6,
