-- NHẬN DIỆN TEAM
-- Cách chính: MÀU TÊN. Tên mình màu gì -> người tên cùng màu = đồng đội, màu khác = địch.
-- Dự phòng 1 (chưa đọc được màu tên mình): xanh nước biển = đồng đội, đỏ = địch.
-- Dự phòng 2 (không đọc được màu tên người đó): so Team / TeamColor / Attribute / Value.
-- Không biết gì cả => coi là KẺ ĐỊCH (thà bắn nhầm còn hơn bỏ sót).
---------------------------------------------------------------------
local TEAM_ATTRS = { "Team", "team", "TeamName", "TeamId", "TeamID", "Side", "Faction", "Squad" }
-- Giá trị kiểu tên CHẾ ĐỘ chơi (giống nhau cho mọi người) chứ không phải team thật -> không tính là cùng đội
local TEAM_IGNORE_VALUES = { ffa = true, solo = true, none = true, ["nil"] = true, neutral = true, individual = true, [""] = true }

local function teamKey(p)
    if isPlayerEntity(p) then
        if p.Team then return "T:" .. p.Team.Name end
        if not p.Neutral then return "C:" .. tostring(p.TeamColor) end
    end
    for _, n in ipairs(TEAM_ATTRS) do
        local v = p:GetAttribute(n)
        if v ~= nil then return "A:" .. tostring(v) end
    end
    local c = getChar(p)
    if c then
        for _, n in ipairs(TEAM_ATTRS) do
            local v = c:GetAttribute(n)
            if v ~= nil then return "CA:" .. tostring(v) end
        end
    end
    for _, n in ipairs(TEAM_ATTRS) do
        local o = p:FindFirstChild(n)
        if o and o:IsA("ValueBase") then return "V:" .. tostring(o.Value) end
    end
    return nil
end

local function filteredTeamKey(p)
    local k = teamKey(p)
    if not k then return nil end
    local val = k:match("^.-:(.*)$") or k
    if TEAM_IGNORE_VALUES[val:lower()] then return nil end
    return k
end

-- cache có kiểm tra đổi nhân vật: người vừa hồi sinh / vừa vào sẽ được đọc lại ngay, không dùng dữ liệu cũ
local teamCache = setmetatable({}, { __mode = "k" })
local function cachedTeamKey(p)
    local char, now = getChar(p), tick()
    local e = teamCache[p]
    if not e or e.char ~= char or now - e.t > 0.5 then
        e = { k = filteredTeamKey(p), t = now, char = char }
        teamCache[p] = e
    end
    return e.k
end

local function colorDist(a, b)
    return math.sqrt((a.R - b.R) ^ 2 + (a.G - b.G) ^ 2 + (a.B - b.B) ^ 2)
end

-- Dự phòng khi chưa biết màu tên của mình: xanh nước biển/xanh dương = đồng đội, đỏ = địch
local function colorSide(color)
    if not color then return nil end
    local r, g, b = color.R, color.G, color.B
    if b > r + 0.2 and b >= g and b > 0.3 then return "ally" end
    if r > g + 0.15 and r > b + 0.15 and r > 0.25 then return "enemy" end
    return nil
end

-- Đọc màu chữ của 1 bảng tên (ưu tiên nhãn có chứa tên/biệt danh của người đó, không có thì lấy nhãn đầu tiên)
local function labelColorIn(root, p)
    local fallback
    local nm, dn = p.Name:lower(), getDisplayName(p):lower()
    for _, d in ipairs(root:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then
            local t = d.Text:lower()
            if t:find(nm, 1, true) or t:find(dn, 1, true) then return d.TextColor3, true end
            fallback = fallback or d.TextColor3
        end
    end
    return fallback, false
end

local function findNameplateColor(p)
    local c = getChar(p)
    if not c then return nil end
    local best
    -- 1) bảng tên gắn trong nhân vật
    for _, bb in ipairs(c:GetDescendants()) do
        if bb:IsA("BillboardGui") then
            local col, exact = labelColorIn(bb, p)
            if col then
                if exact then return col end
                best = best or col
            end
        end
    end
    if best then return best end
    -- 2) bảng tên nằm trong PlayerGui nhưng bám vào nhân vật (Adornee)
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if pg then
        for _, bb in ipairs(pg:GetChildren()) do
            if bb:IsA("BillboardGui") and bb.Adornee and bb.Adornee:IsDescendantOf(c) then
                local col = labelColorIn(bb, p)
                if col then return col end
            end
        end
    end
    return nil
end

-- Dự phòng: nhiều game dùng bảng tên MẶC ĐỊNH của Roblox (do engine tự vẽ, không phải BillboardGui
-- nằm trong nhân vật) nên không đọc được màu chữ ở trên -> dùng MÀU ĐỘI (Player.TeamColor) nếu có team thật
local function teamColorOf(p)
    if not isPlayerEntity(p) then return nil end
    local okNeutral, neutral = pcall(function() return p.Neutral end)
    if okNeutral and neutral then return nil end -- không có team thật -> màu đội không có ý nghĩa
    local ok, col = pcall(function() return p.TeamColor.Color end)
    if ok then return col end
    return nil
end

local function findIdentityColor(p)
    local c = findNameplateColor(p)
    if c then return c end
    return teamColorOf(p)
end

local sideCache = setmetatable({}, { __mode = "k" })
local function cachedNameColor(p)
    local char, now = getChar(p), tick()
    local e = sideCache[p]
    -- chưa đọc được màu thì thử lại nhanh hơn (bảng tên có thể hiện muộn sau khi spawn)
    if not e or e.char ~= char or now - e.t > (e.c and 1.5 or 0.5) then
        e = { c = findIdentityColor(p), t = now, char = char }
        sideCache[p] = e
    end
    return e.c
end

-- màu tên của MÌNH (nhớ lần đọc cuối cùng, lúc đang chết / chưa spawn vẫn dùng được)
local lastMyColor = nil
local function myNameColor()
    local c = cachedNameColor(LP)
    if c then lastMyColor = c end
    return lastMyColor
end

-- Trắng mặc định của Roblox (chưa có màu team): không phân biệt được ai -> mọi người đều là kẻ địch
local function isWhite(c)
    local mx, mn = math.max(c.R, c.G, c.B), math.min(c.R, c.G, c.B)
    return mn >= 0.85 and (mx - mn) <= 0.1
end

local function sideOf(p)
    local mine = myNameColor()
    if mine and isWhite(mine) then return "enemy" end -- tên mình trắng -> mọi người chơi đều là địch
    local col = cachedNameColor(p)
    if not col then return nil end
    if isWhite(col) then return "enemy" end           -- tên người đó trắng -> địch
    if mine then
        return (colorDist(col, mine) <= CFG.TeamColorTol) and "ally" or "enemy"
    end
    return colorSide(col)
end

local function skip(p)
    if not CFG.TeamCheck then return false end
    if not isPlayerEntity(p) then return false end -- NPC: không áp dụng team, luôn tính là địch
    local side = sideOf(p)
    if side == "ally" then return true end
    if side == "enemy" then return false end
    -- không đọc được màu tên người này -> dự phòng so khớp thuộc tính team
    local a, b = cachedTeamKey(p), cachedTeamKey(LP)
    return a ~= nil and b ~= nil and a == b
end

-- In thông tin team / màu tên của mọi người để xem game đánh dấu team bằng cái gì
